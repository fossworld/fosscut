{
  "$defs": {
    "Asset": {
      "description": "A source media file referenced by clips. Splitting a clip never copies an asset.",
      "properties": {
        "folder": {
          "description": "The bin folder it is in; the top level when omitted. Organizing media never changes\nits identity (ADR-0004, item 3).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Asset id (`asset_…`)."
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content identity used to relink moved files."
        },
        "info": {
          "$ref": "#/$defs/MediaInfo",
          "description": "Stream information recorded at import."
        },
        "kind": {
          "$ref": "#/$defs/AssetKind",
          "description": "Media kind."
        },
        "name": {
          "description": "Display name, usually the file name.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/PathHints",
          "description": "Where to find the file."
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "path"
      ],
      "type": "object"
    },
    "AssetKind": {
      "description": "What kind of media an asset is.",
      "oneOf": [
        {
          "const": "video",
          "description": "Moving picture, possibly with audio.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound only.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "A still image.",
          "type": "string"
        },
        {
          "const": "lut",
          "description": "A 3D color lookup table (`.cube`), used by the `color.lut` effect.",
          "type": "string"
        },
        {
          "const": "font",
          "description": "A font file (`.ttf`, `.otf`, `.ttc`) whose families text can use (ADR-0027).",
          "type": "string"
        },
        {
          "const": "vector",
          "description": "A vector drawing (`.svg`, ADR-0036): shown as an image, drawn sharp at any size, and\nsplit into editable shape clips by `vector.explode`.",
          "type": "string"
        },
        {
          "const": "web",
          "description": "A web composition (ADR-0039): an HTML page, with the files it loads, copied into the\nbundle's `web/` folder and rendered frame by frame in a headless browser. Video clips\nshow it like a video; its size and frame rate are in `video`, its length in\n`duration`.",
          "type": "string"
        },
        {
          "const": "model",
          "description": "A 3D model (`.glb`, or `.gltf` with its buffers and textures, ADR-0040), copied\ninto the bundle's `models/` folder by content and shown by 3D object clips.",
          "type": "string"
        }
      ]
    },
    "AudioInfo": {
      "description": "Audio stream properties.",
      "properties": {
        "channels": {
          "description": "Channel count.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "codec": {
          "description": "Codec name, for example `aac`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_rate": {
          "description": "Sample rate in Hz.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sample_rate",
        "channels"
      ],
      "type": "object"
    },
    "ContentIdentity": {
      "description": "Identity of a file's content: its size and a BLAKE3 hash of its first and last MiB.",
      "properties": {
        "sample_blake3": {
          "description": "Hex BLAKE3 digest of the size, the first MiB and the last MiB of the file.",
          "type": "string"
        },
        "size": {
          "description": "File size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "sample_blake3"
      ],
      "type": "object"
    },
    "Flicks": {
      "description": "Time in flicks: 1/705,600,000 of a second (ADR-0005). 30 fps frames are 23,520,000 flicks long.",
      "type": "integer"
    },
    "FontInfo": {
      "description": "What a font file holds.",
      "properties": {
        "faces": {
          "description": "Number of faces (a collection holds several).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "families": {
          "description": "Family names, sorted, as text styles name them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "families",
        "faces"
      ],
      "type": "object"
    },
    "Id": {
      "description": "Stable object id: kind prefix and lowercase Crockford base32, for example clip_0007 or track_000a.",
      "pattern": "^[a-z]+_[0-9a-hjkmnp-tv-z]{4,13}$",
      "type": "string"
    },
    "LutInfo": {
      "description": "A LUT file's table.",
      "properties": {
        "size": {
          "description": "Entries per axis, for example 33.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "MediaInfo": {
      "description": "Stream information probed at import.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary audio stream."
        },
        "container": {
          "description": "Container format name, for example `mov,mp4,m4a,3gp,3g2,mj2`.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Flicks"
            },
            {
              "type": "null"
            }
          ],
          "description": "Playable duration; absent for still images."
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "The families and faces in a font asset."
        },
        "lut": {
          "anyOf": [
            {
              "$ref": "#/$defs/LutInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Size of a LUT asset's table."
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "What a 3D model holds (ADR-0040)."
        },
        "vector": {
          "anyOf": [
            {
              "$ref": "#/$defs/VectorInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "What a vector drawing holds; its size in pixels is in `video`."
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primary video stream."
        }
      },
      "type": "object"
    },
    "ModelInfo": {
      "description": "What a 3D model file holds (ADR-0040), probed at import.",
      "properties": {
        "copyright": {
          "description": "The file's own copyright line, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "description": "The file's own note of the tool that wrote it, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "materials": {
          "description": "Materials.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "meshes": {
          "description": "Meshes its default scene draws.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "The size of its bounds `[x, y, z]` in its own units (metres in glTF), y up.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "textures": {
          "description": "Images its materials use.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "triangles": {
          "description": "Triangles drawn.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "meshes",
        "triangles",
        "materials",
        "textures",
        "size"
      ],
      "type": "object"
    },
    "PathHints": {
      "description": "Path hints for a source file. Relative paths are relative to the project bundle.",
      "properties": {
        "absolute": {
          "description": "Absolute path at import time.",
          "type": [
            "string",
            "null"
          ]
        },
        "relative": {
          "description": "Path relative to the `.fosscut` bundle directory, with `/` separators.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Rate": {
      "description": "Exact frame rate as an integer or a fraction string, for example \"30\" or \"30000/1001\" (29.97). Decimals are not accepted.",
      "oneOf": [
        {
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$",
          "type": "string"
        },
        {
          "minimum": 1,
          "type": "integer"
        }
      ]
    },
    "VectorInfo": {
      "description": "What a vector drawing (`.svg`) holds (ADR-0036).",
      "properties": {
        "paths": {
          "description": "How many path elements it draws, each a shape clip when exploded.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "view_box": {
          "description": "Its view box `[x, y, width, height]` in its own units.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "view_box",
        "paths"
      ],
      "type": "object"
    },
    "VideoInfo": {
      "description": "Video stream properties.",
      "properties": {
        "codec": {
          "description": "Codec name, for example `h264`.",
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "description": "Coded height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Frame rate, when constant and known."
        },
        "rotation": {
          "description": "Display rotation from the container's display matrix in degrees counterclockwise,\nas FFmpeg reports it (for example -90 for portrait phone video).",
          "format": "int32",
          "type": "integer"
        },
        "width": {
          "description": "Coded width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The media table: one immutable record per source file (`media.json`).",
  "properties": {
    "assets": {
      "default": [],
      "description": "Imported assets in import order.",
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "type": "array"
    },
    "folders": {
      "description": "Folders of the media bin as paths such as `B-roll/Day 1`, sorted; each parent is\nlisted too.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "Media",
  "type": "object"
}
