{
  "$defs": {
    "Align": {
      "description": "Horizontal text alignment.",
      "oneOf": [
        {
          "const": "left",
          "description": "Left aligned.",
          "type": "string"
        },
        {
          "const": "center",
          "description": "Centred.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Right aligned.",
          "type": "string"
        }
      ]
    },
    "Animation": {
      "description": "One of a clip's animations: a preset and how long it takes.",
      "properties": {
        "duration": {
          "$ref": "#/$defs/Flicks",
          "description": "How long it takes; combo animations repeat with this period."
        },
        "preset": {
          "description": "The preset, such as `fade` or `slide_left`.",
          "type": "string"
        }
      },
      "required": [
        "preset",
        "duration"
      ],
      "type": "object"
    },
    "Animator": {
      "description": "A caption animator (ADR-0021 item 3): its type, version, switch and parameters.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The page fades in and out.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/PageFade",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "page.fade",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The page scales in.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/PagePop",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "page.pop",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Each word appears when it is spoken.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/WordReveal",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "word.reveal",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The spoken word changes colour, gains a box or grows.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/WordHighlight",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "word.highlight",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Each word pops up and back as it is spoken.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/WordPop",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "word.pop",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Each word fills from left to right while it is spoken.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/WordKaraoke",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "word.karaoke",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Words marked `emphasis` stand out.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Whether it is applied; on when omitted.",
              "type": "boolean"
            },
            "params": {
              "$ref": "#/$defs/WordEmphasis",
              "description": "Parameters; defaults when omitted."
            },
            "type": {
              "const": "word.emphasis",
              "type": "string"
            },
            "version": {
              "default": 1,
              "description": "Parameter version; 1 when omitted.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "AssetRef": {
      "description": "A reference to a media asset, such as a LUT file.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Id",
          "description": "The asset (`asset_…`)."
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "BlendMode": {
      "description": "How a clip's picture combines with the layers below it. Every mode except `normal`\nworks on display-encoded (sRGB) values, as designers expect, and then mixes by the\nclip's opacity (ADR-0011, item 4).",
      "oneOf": [
        {
          "const": "normal",
          "description": "Covers what is below.",
          "type": "string"
        },
        {
          "const": "multiply",
          "description": "Darkens: below times the picture.",
          "type": "string"
        },
        {
          "const": "screen",
          "description": "Lightens: the inverse of multiplying the inverses.",
          "type": "string"
        },
        {
          "const": "overlay",
          "description": "Multiply in the shadows of what is below and screen in its highlights.",
          "type": "string"
        },
        {
          "const": "darken",
          "description": "The darker of the two, per channel.",
          "type": "string"
        },
        {
          "const": "lighten",
          "description": "The lighter of the two, per channel.",
          "type": "string"
        },
        {
          "const": "color_dodge",
          "description": "Brightens what is below to reflect the picture.",
          "type": "string"
        },
        {
          "const": "color_burn",
          "description": "Darkens what is below to reflect the picture.",
          "type": "string"
        },
        {
          "const": "hard_light",
          "description": "Overlay with the roles swapped: the picture decides multiply or screen.",
          "type": "string"
        },
        {
          "const": "soft_light",
          "description": "A gentler hard light.",
          "type": "string"
        },
        {
          "const": "linear_burn",
          "description": "Sum minus one: darkens more than multiply.",
          "type": "string"
        },
        {
          "const": "add",
          "description": "Sum (linear dodge), clipped at white.",
          "type": "string"
        },
        {
          "const": "difference",
          "description": "Absolute difference.",
          "type": "string"
        },
        {
          "const": "exclusion",
          "description": "Like difference with lower contrast.",
          "type": "string"
        }
      ]
    },
    "BrushStroke": {
      "description": "One painted stroke of a brush mask.",
      "properties": {
        "erase": {
          "description": "Erases instead of painting.",
          "type": "boolean"
        },
        "points": {
          "description": "The stroke's path in the picture, 0 to 1 from its top-left corner.",
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "radius": {
          "description": "The brush's radius as a fraction of the picture's height.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "points",
        "radius"
      ],
      "type": "object"
    },
    "CaptionBox": {
      "additionalProperties": false,
      "description": "A box behind each line of text.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Its colour (black at 70% when omitted)."
        },
        "enabled": {
          "description": "Whether it is drawn.",
          "type": "boolean"
        },
        "padding": {
          "description": "Space around the text as a fraction of the font size (0.25 when omitted).",
          "format": "double",
          "type": "number"
        },
        "radius": {
          "description": "Corner radius as a fraction of the box height (0.3 when omitted).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "CaptionContent": {
      "description": "One caption page: what is on screen at once.",
      "properties": {
        "lines": {
          "description": "Lines from top to bottom.",
          "items": {
            "$ref": "#/$defs/CaptionLine"
          },
          "type": "array"
        }
      },
      "required": [
        "lines"
      ],
      "type": "object"
    },
    "CaptionLine": {
      "description": "One line of a caption page.",
      "properties": {
        "words": {
          "description": "Words from left to right.",
          "items": {
            "$ref": "#/$defs/CaptionWord"
          },
          "type": "array"
        }
      },
      "required": [
        "words"
      ],
      "type": "object"
    },
    "CaptionStyle": {
      "additionalProperties": false,
      "description": "How a caption track's captions look and move; every field has a default.",
      "properties": {
        "align": {
          "$ref": "#/$defs/Align",
          "description": "Horizontal alignment of lines."
        },
        "animators": {
          "description": "Animation, evaluated per frame from word times.",
          "items": {
            "$ref": "#/$defs/Animator"
          },
          "type": "array"
        },
        "box": {
          "$ref": "#/$defs/CaptionBox",
          "description": "Background box behind each line (off when omitted)."
        },
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Text colour (white when omitted)."
        },
        "font": {
          "description": "Font family; the bundled sans-serif when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "italic": {
          "description": "Italic style.",
          "type": "boolean"
        },
        "placement": {
          "$ref": "#/$defs/Placement",
          "description": "Where the page sits inside the safe area (bottom when omitted)."
        },
        "size": {
          "description": "Font size as a fraction of the canvas height (0.055 when omitted).",
          "format": "double",
          "type": "number"
        },
        "stroke": {
          "$ref": "#/$defs/Stroke",
          "description": "Outline around the letters (black, on, when omitted)."
        },
        "uppercase": {
          "description": "Show words in capitals.",
          "type": "boolean"
        },
        "weight": {
          "$ref": "#/$defs/FontWeight",
          "description": "Font weight (bold when omitted)."
        }
      },
      "type": "object"
    },
    "CaptionWord": {
      "description": "A timed word.",
      "properties": {
        "emphasis": {
          "description": "A keyword the `word.emphasis` animator styles.",
          "type": "boolean"
        },
        "end": {
          "$ref": "#/$defs/Flicks",
          "description": "When it ends, from the clip's start."
        },
        "start": {
          "$ref": "#/$defs/Flicks",
          "description": "When it is spoken, from the clip's start."
        },
        "text": {
          "description": "The word as shown, with attached punctuation.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start",
        "end"
      ],
      "type": "object"
    },
    "ChannelMode": {
      "description": "Which channels of a clip's sound play where (fill channel).",
      "oneOf": [
        {
          "const": "stereo",
          "description": "As recorded.",
          "type": "string"
        },
        {
          "const": "left",
          "description": "The left channel fills both.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "The right channel fills both.",
          "type": "string"
        },
        {
          "const": "mono",
          "description": "Both channels mixed to one, played on both.",
          "type": "string"
        }
      ]
    },
    "Clip": {
      "description": "A clip on a track. The content kind decides which fields apply.",
      "oneOf": [
        {
          "description": "A section of a video asset.",
          "properties": {
            "asset": {
              "$ref": "#/$defs/Id",
              "description": "The asset (`asset_…`)."
            },
            "kind": {
              "const": "video",
              "type": "string"
            },
            "source_in": {
              "$ref": "#/$defs/Flicks",
              "description": "Source position of the clip's first frame."
            }
          },
          "required": [
            "kind",
            "asset"
          ],
          "type": "object"
        },
        {
          "description": "A section of an audio asset (or the audio of a video asset).",
          "properties": {
            "asset": {
              "$ref": "#/$defs/Id",
              "description": "The asset (`asset_…`)."
            },
            "kind": {
              "const": "audio",
              "type": "string"
            },
            "source_in": {
              "$ref": "#/$defs/Flicks",
              "description": "Source position of the clip's first sample."
            }
          },
          "required": [
            "kind",
            "asset"
          ],
          "type": "object"
        },
        {
          "description": "A still image held for the clip duration.",
          "properties": {
            "asset": {
              "$ref": "#/$defs/Id",
              "description": "The asset (`asset_…`)."
            },
            "kind": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "asset"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TextContent",
          "description": "A text title.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/CaptionContent",
          "description": "A caption page: lines of timed words (ADR-0021).",
          "properties": {
            "kind": {
              "const": "caption",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An adjustment layer: its effects apply to everything below it while it lasts.",
          "properties": {
            "kind": {
              "const": "adjustment",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "animations": {
          "$ref": "#/$defs/ClipAnimations",
          "description": "How the clip moves in, out and while it shows."
        },
        "audio": {
          "$ref": "#/$defs/ClipAudio",
          "description": "Fades, pan and channels of the clip's sound; unchanged when omitted."
        },
        "blend": {
          "$ref": "#/$defs/BlendMode",
          "description": "How the picture combines with the layers below it (normal when omitted)."
        },
        "crop": {
          "$ref": "#/$defs/Crop",
          "description": "Edges of the picture removed; nothing when omitted."
        },
        "duration": {
          "$ref": "#/$defs/Flicks",
          "description": "Length on the timeline."
        },
        "effects": {
          "description": "Effects on the clip's picture, applied in order before placement. On an adjustment\nclip they apply to everything below it.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "enabled": {
          "description": "False deactivates the clip: it keeps its place but is neither drawn nor heard.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Clip id (`clip_…`)."
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "description": "Keyframes by property path (`transform.position`, `opacity`, ...), each list sorted\nby time with at most one keyframe per time. A property with keyframes takes its\nvalue from them, not from its field.",
          "type": "object"
        },
        "masks": {
          "description": "Masks that decide which parts of the picture show, combined in order; on an\nadjustment clip, where its effects apply.",
          "items": {
            "$ref": "#/$defs/Mask"
          },
          "type": "array"
        },
        "opacity": {
          "description": "Opacity from 0 to 1.",
          "format": "double",
          "type": "number"
        },
        "start": {
          "$ref": "#/$defs/Flicks",
          "description": "Timeline position of the first frame."
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "description": "Placement on the canvas; identity when omitted."
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "description": "The transition into the next clip on the track, played over the cut when the next\nclip starts where this one ends."
        },
        "volume": {
          "description": "Linear audio gain (1 is unchanged, 0 is silent).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "start",
        "duration"
      ],
      "type": "object"
    },
    "ClipAnimations": {
      "description": "How a clip moves in, out and while it shows.",
      "properties": {
        "combo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Animation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Repeats for as long as the clip shows."
        },
        "in": {
          "anyOf": [
            {
              "$ref": "#/$defs/Animation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Plays from the clip's start."
        },
        "out": {
          "anyOf": [
            {
              "$ref": "#/$defs/Animation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Plays up to the clip's end."
        }
      },
      "type": "object"
    },
    "ClipAudio": {
      "description": "How a clip's sound is shaped: fades, pan and channels.",
      "properties": {
        "channels": {
          "$ref": "#/$defs/ChannelMode",
          "description": "Which source channels play."
        },
        "fade_in": {
          "$ref": "#/$defs/Flicks",
          "description": "Fade in from silence over this long at the clip's start."
        },
        "fade_out": {
          "$ref": "#/$defs/Flicks",
          "description": "Fade out to silence over this long at the clip's end."
        },
        "pan": {
          "description": "Stereo balance: -1 left, 0 centre (both sides unchanged), 1 right.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Color": {
      "description": "sRGB colour #RRGGBB or #RRGGBBAA.",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "type": "string"
    },
    "Crop": {
      "description": "Edges removed from a clip's picture, as fractions of its width and height before any\nflip. What remains keeps its size and place on the canvas.",
      "properties": {
        "bottom": {
          "description": "Fraction of the height removed at the bottom.",
          "format": "double",
          "type": "number"
        },
        "left": {
          "description": "Fraction of the width removed on the left.",
          "format": "double",
          "type": "number"
        },
        "right": {
          "description": "Fraction of the width removed on the right.",
          "format": "double",
          "type": "number"
        },
        "top": {
          "description": "Fraction of the height removed at the top.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Effect": {
      "description": "An effect on a clip.",
      "properties": {
        "enabled": {
          "description": "False bypasses the effect without removing it.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Effect id (`effect_…`)."
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "description": "Keyframes of numeric parameters by parameter name, each sorted by time from the\nclip's start. A parameter with keyframes takes its value from them.",
          "type": "object"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/ParamValue"
          },
          "description": "Parameters that differ from their defaults.",
          "type": "object"
        },
        "type": {
          "description": "The effect type, such as `color.adjust`.",
          "type": "string"
        },
        "version": {
          "description": "Version of the type's parameters this instance was written with.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "version"
      ],
      "type": "object"
    },
    "Flicks": {
      "description": "Time in flicks: 1/705,600,000 of a second (ADR-0005). 30 fps frames are 23,520,000 flicks long.",
      "type": "integer"
    },
    "FontWeight": {
      "description": "Font weights of the bundled fonts.",
      "oneOf": [
        {
          "const": "regular",
          "description": "Regular (400).",
          "type": "string"
        },
        {
          "const": "bold",
          "description": "Bold (700).",
          "type": "string"
        },
        {
          "const": "extra_bold",
          "description": "Extra bold (800).",
          "type": "string"
        },
        {
          "const": "black",
          "description": "Black (900).",
          "type": "string"
        }
      ]
    },
    "Id": {
      "description": "Stable object id: kind prefix and lowercase Crockford base32, for example clip_0007 or track_000a.",
      "pattern": "^[a-z]+_[0-9a-hjkmnp-tv-z]{4,13}$",
      "type": "string"
    },
    "Interpolation": {
      "description": "How a value travels from one keyframe to the next.",
      "oneOf": [
        {
          "const": "hold",
          "description": "Keeps this keyframe's value until the next keyframe.",
          "type": "string"
        },
        {
          "const": "linear",
          "description": "Changes at a constant rate.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Follows the cubic Bezier easing curve from (0, 0) to (1, 1) with control points\n`[x1, y1, x2, y2]`, as in CSS: x is the fraction of the time between the keyframes\nand y the fraction of the change. x1 and x2 are between 0 and 1.",
          "properties": {
            "bezier": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            }
          },
          "required": [
            "bezier"
          ],
          "type": "object"
        }
      ]
    },
    "KeyValue": {
      "anyOf": [
        {
          "description": "A number, such as a scale or an opacity.",
          "format": "double",
          "type": "number"
        },
        {
          "description": "A pair, such as a position `[x, y]`.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      ],
      "description": "A keyframed value: a number, or a pair such as a position."
    },
    "Keyframe": {
      "description": "A property's value at one time.",
      "properties": {
        "interpolation": {
          "$ref": "#/$defs/Interpolation",
          "description": "How the value moves from this keyframe to the next (linear when omitted)."
        },
        "time": {
          "$ref": "#/$defs/Flicks",
          "description": "Time from the clip's start; it may lie outside the clip after a trim."
        },
        "value": {
          "$ref": "#/$defs/KeyValue",
          "description": "The value at that time."
        }
      },
      "required": [
        "time",
        "value"
      ],
      "type": "object"
    },
    "Mask": {
      "description": "A mask on a clip.",
      "properties": {
        "center": {
          "description": "The middle of the mask in the picture, 0 to 1 from the top-left corner (the middle\nwhen omitted).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "enabled": {
          "description": "False ignores the mask without removing it.",
          "type": "boolean"
        },
        "expansion": {
          "description": "Grows (positive) or shrinks (negative) the shape, -1 to 1, as a fraction of its\nsmaller half size.",
          "format": "double",
          "type": "number"
        },
        "feather": {
          "description": "Softness of the edge, 0 (sharp) to 1, as a fraction of the mask's smaller half size.",
          "format": "double",
          "type": "number"
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Mask id (`mask_…`)."
        },
        "invert": {
          "description": "Keeps the outside instead of the inside.",
          "type": "boolean"
        },
        "keyframes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Keyframe"
            },
            "type": "array"
          },
          "description": "Keyframes by property (`center`, `size`, `rotation`, `feather`, `expansion`,\n`roundness`), times from the clip's start.",
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/MaskMode",
          "description": "How it combines with the masks before it."
        },
        "points": {
          "description": "Points of a path mask.",
          "items": {
            "$ref": "#/$defs/PathPoint"
          },
          "type": "array"
        },
        "rotation": {
          "description": "Clockwise rotation in degrees.",
          "format": "double",
          "type": "number"
        },
        "roundness": {
          "description": "Rounds a rectangle's corners, 0 (square) to 1 (fully round).",
          "format": "double",
          "type": "number"
        },
        "shape": {
          "$ref": "#/$defs/MaskShape",
          "default": "rectangle",
          "description": "Its shape."
        },
        "size": {
          "description": "Width and height as fractions of the picture's (half of each when omitted).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "strokes": {
          "description": "Strokes of a brush mask.",
          "items": {
            "$ref": "#/$defs/BrushStroke"
          },
          "type": "array"
        },
        "text": {
          "description": "Text of a text mask.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "MaskMode": {
      "description": "How a mask combines with the masks before it.",
      "oneOf": [
        {
          "const": "add",
          "description": "Shows what this mask covers as well.",
          "type": "string"
        },
        {
          "const": "subtract",
          "description": "Hides what this mask covers.",
          "type": "string"
        },
        {
          "const": "intersect",
          "description": "Shows only what this mask and the ones before cover.",
          "type": "string"
        }
      ]
    },
    "MaskShape": {
      "description": "The shape of a mask.",
      "oneOf": [
        {
          "const": "rectangle",
          "description": "A rectangle, with corners rounded by `roundness`.",
          "type": "string"
        },
        {
          "const": "ellipse",
          "description": "An ellipse filling the mask's box.",
          "type": "string"
        },
        {
          "const": "linear",
          "description": "Everything on one side of a line through the centre (above it, before rotation).",
          "type": "string"
        },
        {
          "const": "mirror",
          "description": "A band through the centre, `size` high: the mirror shape.",
          "type": "string"
        },
        {
          "const": "star",
          "description": "A five-pointed star.",
          "type": "string"
        },
        {
          "const": "heart",
          "description": "A heart.",
          "type": "string"
        },
        {
          "const": "path",
          "description": "A closed path through `points`, straight or curved by their handles: the pen.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "The letters of `text`, filling the mask's box.",
          "type": "string"
        },
        {
          "const": "brush",
          "description": "Painted `strokes`.",
          "type": "string"
        }
      ]
    },
    "PageFade": {
      "additionalProperties": false,
      "description": "Parameters of `page.fade`.",
      "properties": {
        "in_ms": {
          "default": 120,
          "description": "Fade-in length in milliseconds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "out_ms": {
          "default": 120,
          "description": "Fade-out length in milliseconds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PagePop": {
      "additionalProperties": false,
      "description": "Parameters of `page.pop`.",
      "properties": {
        "duration_ms": {
          "default": 150,
          "description": "Length in milliseconds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "from": {
          "default": 0.8,
          "description": "Scale the page starts from.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "ParamValue": {
      "anyOf": [
        {
          "description": "A number.",
          "format": "double",
          "type": "number"
        },
        {
          "description": "A pair such as a color wheel position `[x, y]`.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "description": "On or off.",
          "type": "boolean"
        },
        {
          "description": "One of a fixed set of names.",
          "type": "string"
        },
        {
          "description": "Curve control points `[[x, y], ...]` from 0 to 1, sorted by x.",
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/AssetRef",
          "description": "A media asset."
        }
      ],
      "description": "A parameter value."
    },
    "PathPoint": {
      "description": "A point of a path mask, with optional Bezier handles relative to it.",
      "properties": {
        "at": {
          "description": "The point in the mask's box, -1 to 1.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "in": {
          "description": "The handle towards the previous point; a corner when omitted.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "out": {
          "description": "The handle towards the next point; a corner when omitted.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "Placement": {
      "description": "Where a caption page sits inside the canvas's safe area (ADR-0021 item 5).",
      "oneOf": [
        {
          "const": "top",
          "description": "At the top of the safe area.",
          "type": "string"
        },
        {
          "const": "middle",
          "description": "Centred.",
          "type": "string"
        },
        {
          "const": "bottom",
          "description": "At the bottom of the safe area.",
          "type": "string"
        }
      ]
    },
    "Rate": {
      "description": "Exact frame rate as an integer or a fraction string, for example \"30\" or \"30000/1001\" (29.97). Decimals are not accepted.",
      "oneOf": [
        {
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$",
          "type": "string"
        },
        {
          "minimum": 1,
          "type": "integer"
        }
      ]
    },
    "Stroke": {
      "additionalProperties": false,
      "description": "An outline around the letters.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Its colour (black when omitted)."
        },
        "enabled": {
          "description": "Whether it is drawn.",
          "type": "boolean"
        },
        "width": {
          "description": "Its width as a fraction of the font size (0.12 when omitted).",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "TextContent": {
      "description": "Text content with a single style.",
      "properties": {
        "style": {
          "$ref": "#/$defs/TextStyle",
          "description": "Appearance; defaults when omitted."
        },
        "text": {
          "description": "The text; `\\n` separates lines.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "TextStyle": {
      "description": "Text appearance.",
      "properties": {
        "align": {
          "$ref": "#/$defs/Align",
          "description": "Horizontal alignment of lines."
        },
        "bold": {
          "description": "Bold weight.",
          "type": "boolean"
        },
        "color": {
          "$ref": "#/$defs/Color",
          "default": "#FFFFFF",
          "description": "Fill colour."
        },
        "font": {
          "description": "Font family; the default sans-serif font when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "italic": {
          "description": "Italic style.",
          "type": "boolean"
        },
        "size": {
          "default": 0.08,
          "description": "Font size as a fraction of the canvas height.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "TimelineFormat": {
      "description": "Output format of a timeline.",
      "properties": {
        "height": {
          "description": "Canvas height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "$ref": "#/$defs/Rate",
          "description": "Frame rate; edits snap to its frames."
        },
        "sample_rate": {
          "description": "Audio sample rate in Hz.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Canvas width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "rate"
      ],
      "type": "object"
    },
    "Track": {
      "description": "A track: clips ordered by start time that never overlap.",
      "properties": {
        "caption_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionStyle"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the captions of a caption track look and move; defaults when omitted. Only\ncaption tracks have it."
        },
        "clips": {
          "description": "Clips sorted by start time, without overlaps.",
          "items": {
            "$ref": "#/$defs/Clip"
          },
          "type": "array"
        },
        "hidden": {
          "description": "Hides the track's pictures.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Track id (`track_…`)."
        },
        "kind": {
          "$ref": "#/$defs/TrackKind",
          "description": "What the track holds."
        },
        "locked": {
          "description": "Prevents edits to the track.",
          "type": "boolean"
        },
        "muted": {
          "description": "Silences the track.",
          "type": "boolean"
        },
        "name": {
          "description": "Optional display name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "TrackKind": {
      "description": "What a track holds.",
      "oneOf": [
        {
          "const": "video",
          "description": "Video and image clips (their audio plays too).",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Audio clips.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Text clips: titles.",
          "type": "string"
        },
        {
          "const": "caption",
          "description": "Caption clips: pages of timed words, with the look in the track (ADR-0021).",
          "type": "string"
        }
      ]
    },
    "Transform": {
      "description": "Placement of a clip on the canvas.\n\nAt identity the picture is fitted inside the canvas and centred.",
      "properties": {
        "flip_horizontal": {
          "description": "Mirrors the picture left to right.",
          "type": "boolean"
        },
        "flip_vertical": {
          "description": "Mirrors the picture top to bottom.",
          "type": "boolean"
        },
        "position": {
          "description": "Offset of the clip centre from the canvas centre, as fractions of canvas width\nand height; x grows to the right, y grows downwards.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rotation": {
          "description": "Clockwise rotation in degrees.",
          "format": "double",
          "type": "number"
        },
        "scale": {
          "description": "Uniform scale relative to the fitted size (1 when omitted).",
          "format": "double",
          "type": "number"
        },
        "stretch": {
          "description": "Extra width and height factors on top of `scale`, for non-uniform scaling\n(`[1, 1]` when omitted).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "type": "object"
    },
    "Transition": {
      "description": "A transition from a clip to the next one on its track.",
      "properties": {
        "duration": {
          "$ref": "#/$defs/Flicks",
          "description": "How long it lasts, centred on the cut."
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/ParamValue"
          },
          "description": "Parameters that differ from their defaults.",
          "type": "object"
        },
        "type": {
          "description": "The transition type, such as `dissolve` or `wipe`.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "duration"
      ],
      "type": "object"
    },
    "WordEmphasis": {
      "additionalProperties": false,
      "description": "Parameters of `word.emphasis`.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "default": "#FFE14D",
          "description": "Colour of emphasised words."
        },
        "scale": {
          "default": 1.1,
          "description": "Scale of emphasised words.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "WordHighlight": {
      "additionalProperties": false,
      "description": "Parameters of `word.highlight`.",
      "properties": {
        "box_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ],
          "description": "Colour of a box behind the spoken word; none when omitted."
        },
        "color": {
          "$ref": "#/$defs/Color",
          "default": "#FFE14D",
          "description": "Colour of the spoken word."
        },
        "scale": {
          "default": 1.0,
          "description": "Scale of the spoken word.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "WordKaraoke": {
      "additionalProperties": false,
      "description": "Parameters of `word.karaoke`.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "default": "#FFE14D",
          "description": "Colour that fills each word while it is spoken."
        }
      },
      "type": "object"
    },
    "WordPop": {
      "additionalProperties": false,
      "description": "Parameters of `word.pop`.",
      "properties": {
        "duration_ms": {
          "default": 200,
          "description": "Length in milliseconds from the word's start.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scale": {
          "default": 1.2,
          "description": "Largest scale, reached halfway.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "WordReveal": {
      "additionalProperties": false,
      "description": "Parameters of `word.reveal`.",
      "properties": {
        "fade_ms": {
          "default": 80,
          "description": "Fade-in length of each word in milliseconds; 0 shows it at once.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A timeline document (`timelines/<id>.json`).",
  "properties": {
    "format": {
      "$ref": "#/$defs/TimelineFormat",
      "description": "Canvas size, frame rate and audio sample rate."
    },
    "id": {
      "$ref": "#/$defs/Id",
      "description": "Timeline id (`timeline_…`)."
    },
    "name": {
      "description": "Timeline name.",
      "type": "string"
    },
    "tracks": {
      "description": "Tracks from bottom to top: later tracks draw over earlier ones.",
      "items": {
        "$ref": "#/$defs/Track"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "format"
  ],
  "title": "Timeline",
  "type": "object"
}
