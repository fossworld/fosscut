{
  "skill": "fosscut-basics",
  "about": "The safe editing loop of SKILL.md, scripted through fosscut mcp: open, read, dry run, apply with expected_revision and request_id, recover from a stale revision, respect the destructive guard, check frames, export as a job and verify the report.",
  "fixtures": [
    {
      "file": "clip.mp4",
      "about": "4 s of test pattern at 640x360 and 30 fps with a 440 Hz tone, generated by FFmpeg.",
      "ffmpeg": [
        "-f", "lavfi", "-i", "testsrc2=size=640x360:rate=30:duration=4",
        "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000:duration=4",
        "-c:v", "mpeg4", "-q:v", "5", "-c:a", "aac", "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "Open: a new 640x360 project.",
      "tool": "project_new",
      "args": { "path": "Basics.fosscut", "width": 640, "height": 360 },
      "expect": { "revision": 0 }
    },
    {
      "about": "See what FossCut can do.",
      "tool": "capabilities",
      "args": {},
      "expect": { "commands": { "$min_len": 6 }, "export_presets": { "$min_len": 6 } }
    },
    {
      "about": "Look up the arguments of the commands this edit uses.",
      "tool": "capabilities",
      "args": { "names": ["clip.add", "clip.split", "text.add"] },
      "expect": {
        "commands": { "$len": 3 },
        "commands.0.input_schema.required": ["asset"],
        "commands.2.input_schema.required": ["text"]
      }
    },
    {
      "about": "Import the clip.",
      "tool": "media_import",
      "args": { "files": ["clip.mp4"] },
      "save": { "asset": "results.0.asset" }
    },
    {
      "about": "Read before changing anything.",
      "tool": "timeline_read",
      "args": {},
      "expect": { "duration.frames": 0 },
      "save": { "rev": "revision" }
    },
    {
      "about": "Plan: a dry run changes nothing.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }],
        "expected_revision": "${rev}",
        "dry_run": true
      },
      "expect": { "dry_run": true }
    },
    {
      "about": "Apply the clip with the revision just read.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }],
        "expected_revision": "${rev}",
        "request_id": "add-clip",
        "reason": "place the clip"
      },
      "expect": { "results.0.duration.frames": 120 },
      "save": { "clip": "results.0.clip", "rev": "revision" }
    },
    {
      "about": "Add a 2 s title.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "text.add", "args": { "text": "Basics", "duration": "2s" } }],
        "expected_revision": "${rev}",
        "request_id": "add-title"
      },
      "save": { "title_rev": "revision" }
    },
    {
      "about": "A retry with the same request_id returns the first result instead of adding a second title.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "text.add", "args": { "text": "Basics", "duration": "2s" } }],
        "expected_revision": "${rev}",
        "request_id": "add-title"
      },
      "expect": { "replayed": true, "revision": "${title_rev}" }
    },
    {
      "about": "A stale revision is refused and names the current one.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.split", "args": { "clip": "${clip}", "at": "75f" } }],
        "expected_revision": 0
      },
      "expect_error": "fosscut.revision.conflict",
      "expect": { "details.current_revision": "${title_rev}" }
    },
    {
      "about": "Recover: read again before re-applying.",
      "tool": "timeline_read",
      "args": {},
      "save": { "rev": "revision" }
    },
    {
      "about": "Split the clip at 00:00:02:15.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.split", "args": { "clip": "${clip}", "at": { "timecode": "00:00:02:15" } } }],
        "expected_revision": "${rev}",
        "request_id": "split"
      },
      "expect": { "results.0.left.end.frames": 75 },
      "save": { "right": "results.0.right.clip", "rev": "revision" }
    },
    {
      "about": "Removing footage from the main track needs the user's consent.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.remove", "args": { "clip": "${right}" } }],
        "expected_revision": "${rev}"
      },
      "expect_error": "fosscut.guard.destructive"
    },
    {
      "about": "Check: the frame at 1 s.",
      "tool": "frame_grab",
      "args": { "time": "1s" },
      "expect_image": { "width": 640, "height": 360 },
      "expect": { "at.frames": 30 }
    },
    {
      "about": "Check: the whole edit at a glance.",
      "tool": "contact_sheet",
      "args": { "count": 4, "width": 160 },
      "expect_image": { "width": 324, "height": 184 },
      "expect": { "tiles": { "$len": 4 } }
    },
    {
      "about": "Export dry run: what would be written.",
      "tool": "export",
      "args": { "output": "Basics.mp4", "dry_run": true },
      "expect": { "dry_run": true, "plan.frames": 120 }
    },
    {
      "about": "Export the checked revision as a job.",
      "tool": "export",
      "args": { "output": "Basics.mp4", "expected_revision": "${rev}", "request_id": "export" },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "report.frames": 120,
        "report.verified.video.width": 640,
        "report.verified.video.height": 360,
        "report.verified.video.codec": { "$one_of": ["h264", "hevc", "av1"] },
        "report.verified.audio.codec": "aac"
      }
    },
    {
      "about": "The history names the agent.",
      "tool": "history",
      "args": { "limit": 3 },
      "expect": { "entries.0.actor": "agent:fosscut-eval" }
    },
    {
      "about": "Undo reverses the split.",
      "tool": "undo",
      "args": {}
    },
    {
      "about": "One clip again on the video track.",
      "tool": "timeline_read",
      "args": { "detail": "outline" },
      "expect": { "tracks.0.clip_count": 1 }
    }
  ]
}
