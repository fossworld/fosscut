{
  "skill": "talking-head-reel",
  "about": "The reel flow of SKILL.md on read speech under a vertical test pattern, scripted through fosscut mcp: transcribe, record the storyboard as beat markers, an explainer overlay on a beat with its placement and a pop, a punch-in, a background swap switched on for one beat by the effect mix, one-word reel captions with a boxed keyword, a music bed filling the length, levelled speech, ducking, the export refused without the matte analysis, and the final export checked as a dry run. The overlays need a browser to draw, so the eval reads the timeline instead of grabbing frames.",
  "needs": [
    "speech"
  ],
  "fixtures": [
    {
      "file": "speech.flac",
      "about": "LibriSpeech 5105-28233-0005 (CC BY 4.0), committed with its license record.",
      "copy": "fixtures/speech/librispeech-5105-28233-0005/audio.flac"
    },
    {
      "file": "talk.mp4",
      "about": "The speech under a 360x640 vertical test pattern, generated by FFmpeg.",
      "ffmpeg": [
        "-i",
        "speech.flac",
        "-f",
        "lavfi",
        "-i",
        "testsrc2=size=360x640:rate=30:duration=11.5",
        "-map",
        "1:v",
        "-map",
        "0:a",
        "-c:v",
        "mpeg4",
        "-q:v",
        "5",
        "-c:a",
        "aac",
        "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "A vertical project at the footage's size.",
      "tool": "project_new",
      "args": {
        "path": "Reel.fosscut",
        "width": 360,
        "height": 640
      },
      "expect": {
        "revision": 0
      }
    },
    {
      "about": "Import the talk.",
      "tool": "media_import",
      "args": {
        "files": [
          "talk.mp4"
        ]
      },
      "save": {
        "asset": "results.0.asset"
      }
    },
    {
      "about": "The footage on the main track from the start, so asset and timeline times agree.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "clip.add",
            "args": {
              "asset": "${asset}"
            }
          }
        ],
        "request_id": "place-talk"
      },
      "save": {
        "talk": "results.0.clip",
        "rev": "revision"
      }
    },
    {
      "about": "Transcribe: the words and their times drive every beat.",
      "tool": "media_analyze",
      "args": {
        "asset": "${asset}",
        "analyzers": [
          "transcript"
        ],
        "options": {
          "transcript": {
            "model": "whisper-tiny.en"
          }
        },
        "wait_seconds": 60
      },
      "repeat_while": {
        "state": "running"
      },
      "expect": {
        "state": "succeeded",
        "analysis.results.transcript.words": {
          "$min_len": 12
        }
      },
      "save": {
        "b1": "analysis.results.transcript.words.1.start.seconds",
        "b1end": "analysis.results.transcript.words.5.end.seconds",
        "b2": "analysis.results.transcript.words.6.start.seconds",
        "b2end": "analysis.results.transcript.words.10.end.seconds",
        "keyword": "analysis.results.transcript.words.3.text",
        "keyword_at": "analysis.results.transcript.words.3.start.seconds"
      }
    },
    {
      "about": "The approved storyboard: one marker per beat at its first word.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "marker.add",
            "args": {
              "at": "${b1}s",
              "name": "beat 1: the hook -> video-card above the head, punch-in"
            }
          },
          {
            "command": "marker.add",
            "args": {
              "at": "${b2}s",
              "name": "beat 2: the trick -> background swap"
            }
          }
        ],
        "expected_revision": "${rev}",
        "request_id": "storyboard",
        "reason": "the storyboard"
      },
      "expect": {
        "results": {
          "$len": 2
        }
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "The explainer overlays are library compositions.",
      "tool": "library",
      "args": {
        "action": "list",
        "kind": "composition",
        "search": "card"
      },
      "expect": {
        "items": {
          "$min_len": 3
        }
      }
    },
    {
      "about": "Beat 1: a video card pops in on the first word and leaves as the thought ends.",
      "tool": "library",
      "args": {
        "action": "add",
        "name": "video-card",
        "start": "${b1}s",
        "params": {
          "title": "Ten years of editing",
          "views": "1.2M views",
          "hold": 2,
          "speed": 1.5
        },
        "expected_revision": "${rev}",
        "request_id": "beat-1-card"
      },
      "expect": {
        "item.kind": "composition"
      },
      "save": {
        "card": "results.0.clip",
        "rev": "revision"
      }
    },
    {
      "about": "Above the head, where the reference places it, and a pop on its entrance.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "clip.set",
            "args": {
              "clip": "${card}",
              "set": {
                "transform.scale": 0.85,
                "transform.position": [
                  0,
                  -0.29
                ]
              }
            }
          }
        ],
        "expected_revision": "${rev}",
        "request_id": "beat-1-place"
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "The pop under the card's entrance.",
      "tool": "library",
      "args": {
        "action": "add",
        "name": "pop",
        "start": "${b1}s",
        "expected_revision": "${rev}",
        "request_id": "beat-1-pop"
      },
      "expect": {
        "item.kind": "sound"
      },
      "save": {
        "pop": "results.0.clip",
        "rev": "revision"
      }
    },
    {
      "about": "A punch-in on the hook, eased in and out.",
      "tool": "auto_edit",
      "args": {
        "action": "punch_in",
        "clip": "${talk}",
        "moments": [
          {
            "start": "${b1}s",
            "end": "${b1end}s",
            "scale": 1.2
          }
        ],
        "expected_revision": "${rev}"
      },
      "expect": {
        "committed": true
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "Beat 2: the person keyed onto green for this beat only, by keyframing the effect's mix.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "effect.add",
            "args": {
              "clip": "${talk}",
              "type": "key.subject",
              "params": {
                "background": "color",
                "color": "#00C853",
                "mix": 0
              }
            }
          }
        ],
        "expected_revision": "${rev}",
        "request_id": "beat-2-key"
      },
      "save": {
        "key": "results.0.effect",
        "rev": "revision"
      }
    },
    {
      "about": "The swap switches on at the beat and off at its end.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "keyframe.set",
            "args": {
              "clip": "${talk}",
              "property": "effects.${key}.mix",
              "at": "${b2}s",
              "value": 1,
              "easing": "hold"
            }
          },
          {
            "command": "keyframe.set",
            "args": {
              "clip": "${talk}",
              "property": "effects.${key}.mix",
              "at": "${b2end}s",
              "value": 0,
              "easing": "hold"
            }
          }
        ],
        "expected_revision": "${rev}",
        "request_id": "beat-2-switch"
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "One-word reel captions with the keyword boxed, fillers skipped.",
      "tool": "captions",
      "args": {
        "action": "generate",
        "preset": "reel",
        "skip_fillers": true,
        "emphasis": [
          {
            "text": "${keyword}",
            "at": "${keyword_at}s"
          }
        ],
        "expected_revision": "${rev}"
      },
      "expect": {
        "committed": true
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "A music bed filling the whole talk in one clip.",
      "tool": "library",
      "args": {
        "action": "add",
        "name": "chill-loop",
        "start": "0s",
        "duration": "11s",
        "expected_revision": "${rev}",
        "request_id": "music"
      },
      "expect": {
        "item.kind": "music"
      },
      "save": {
        "music": "results.0.clip",
        "rev": "revision"
      }
    },
    {
      "about": "The voice at -14 LUFS.",
      "tool": "audio_normalize",
      "args": {
        "clips": [
          "${talk}"
        ],
        "target_lufs": -14,
        "expected_revision": "${rev}"
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "Sound effects well under the voice (the library's pop is already there, so nothing may change).",
      "tool": "audio_normalize",
      "args": {
        "clips": [
          "${pop}"
        ],
        "target_lufs": -26
      }
    },
    {
      "about": "The music bed about 6 dB under the voice before ducking, so it stays audible.",
      "tool": "audio_normalize",
      "args": {
        "clips": [
          "${music}"
        ],
        "target_lufs": -20
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "The music dips 6 dB while the speaker talks and comes back in the pauses.",
      "tool": "auto_edit",
      "args": {
        "action": "duck",
        "clips": [
          "${music}"
        ],
        "speech": [
          "${talk}"
        ],
        "depth_db": -6,
        "expected_revision": "${rev}"
      },
      "expect": {
        "committed": true
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "The finished timeline: the card placed, the punch-in, the switched key, the ducked music, one word per caption page.",
      "tool": "timeline_read",
      "args": {
        "detail": "full"
      },
      "expect": {
        "markers": {
          "$len": 2
        }
      }
    },
    {
      "about": "Without the matte analysis the export refuses to guess the person's outline: the skill runs media_analyze with matte before keying (it needs a model, so the eval takes the swap out instead).",
      "tool": "export",
      "args": {
        "output": "Reel.mp4",
        "dry_run": true,
        "expected_revision": "${rev}"
      },
      "expect_error": "fosscut.analysis.missing",
      "expect": {
        "details.analyzer": "matte"
      }
    },
    {
      "about": "Take the background swap out, as an agent would without the model.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "effect.remove",
            "args": {
              "clip": "${talk}",
              "effect": "${key}"
            }
          }
        ],
        "expected_revision": "${rev}",
        "request_id": "no-key"
      },
      "save": {
        "rev": "revision"
      }
    },
    {
      "about": "The final export at the footage's size, checked as a dry run.",
      "tool": "export",
      "args": {
        "output": "Reel.mp4",
        "fps": "30",
        "cover": "2s",
        "dry_run": true,
        "expected_revision": "${rev}"
      },
      "expect": {
        "dry_run": true,
        "plan.settings.video.width": 360,
        "plan.settings.video.height": 640
      }
    }
  ]
}
