{
  "skill": "viral-captions",
  "about": "The caption flow of SKILL.md on 11 s of read speech under a tall test pattern, scripted through fosscut mcp: transcribe, generate highlighted captions after a dry run, mark a keyword, restyle, check a frame at a spoken word, write an SRT file and export a verified video.",
  "needs": ["speech"],
  "fixtures": [
    {
      "file": "speech.flac",
      "about": "LibriSpeech 5105-28233-0005 (CC BY 4.0), committed with its license record.",
      "copy": "fixtures/speech/librispeech-5105-28233-0005/audio.flac"
    },
    {
      "file": "talk.mp4",
      "about": "The speech under 11 s of 360x640 test pattern at 30 fps, generated by FFmpeg.",
      "ffmpeg": [
        "-f", "lavfi", "-i", "testsrc2=size=360x640:rate=30:duration=11",
        "-i", "speech.flac",
        "-map", "0:v", "-map", "1:a",
        "-c:v", "mpeg4", "-q:v", "5", "-c:a", "aac", "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "A tall project for a short.",
      "tool": "project_new",
      "args": { "path": "Captions.fosscut", "width": 1080, "height": 1920 },
      "expect": { "revision": 0 }
    },
    {
      "about": "Import the talk.",
      "tool": "media_import",
      "args": { "files": ["talk.mp4"] },
      "save": { "asset": "results.0.asset" }
    },
    {
      "about": "Place it.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }],
        "request_id": "place-talk"
      },
      "save": { "rev": "revision" }
    },
    {
      "about": "The speech model is installed.",
      "tool": "models",
      "args": {},
      "expect": { "models.3.name": "whisper-tiny.en", "models.3.installed": true }
    },
    {
      "about": "Transcribe the talk on this machine.",
      "tool": "media_analyze",
      "args": {
        "asset": "${asset}",
        "analyzers": ["transcript"],
        "options": { "transcript": { "model": "whisper-tiny.en" } },
        "wait_seconds": 60
      },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "analysis.results.transcript.language": "en",
        "analysis.results.transcript.words": { "$min_len": 30 }
      }
    },
    {
      "about": "Plan the captions: a dry run changes nothing.",
      "tool": "captions",
      "args": {
        "action": "generate",
        "preset": "highlight",
        "transcript": { "model": "whisper-tiny.en" },
        "expected_revision": "${rev}",
        "dry_run": true
      },
      "expect": { "dry_run": true, "committed": false }
    },
    {
      "about": "Generate them.",
      "tool": "captions",
      "args": {
        "action": "generate",
        "preset": "highlight",
        "transcript": { "model": "whisper-tiny.en" },
        "expected_revision": "${rev}",
        "request_id": "captions",
        "reason": "word-timed captions"
      },
      "expect": { "committed": true, "results.0.pages": { "$min_len": 6 } },
      "save": { "page": "results.0.pages.2.clip", "rev": "revision" }
    },
    {
      "about": "Generating again would overlap the captions just made.",
      "tool": "captions",
      "args": {
        "action": "generate",
        "transcript": { "model": "whisper-tiny.en" }
      },
      "expect_error": "fosscut.clip.overlap"
    },
    {
      "about": "Read every caption word with its timeline time.",
      "tool": "timeline_read",
      "args": { "detail": "full" },
      "expect": { "tracks.1.kind": "caption", "tracks.1.caption_style.weight": "extra_bold" },
      "save": { "spoken": "tracks.1.clips.2.lines.0.0.start.seconds" }
    },
    {
      "about": "Mark a keyword.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "captions.edit", "args": { "clip": "${page}", "emphasis": [0] } }],
        "expected_revision": "${rev}",
        "request_id": "keyword"
      },
      "save": { "rev": "revision" }
    },
    {
      "about": "Slightly larger captions.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "captions.style", "args": { "style": { "size": 0.06 } } }],
        "expected_revision": "${rev}",
        "request_id": "size"
      },
      "expect": { "results.0.style.size": 0.06 },
      "save": { "rev": "revision" }
    },
    {
      "about": "Look at the frame where the keyword is spoken.",
      "tool": "frame_grab",
      "args": { "time": { "seconds": "${spoken}" }, "width": 270 },
      "expect_image": { "width": 270, "height": 480 }
    },
    {
      "about": "Write a subtitle file too.",
      "tool": "captions",
      "args": { "action": "export", "file": "captions.srt" },
      "expect": { "dry_run": false }
    },
    {
      "about": "It is not overwritten without permission.",
      "tool": "captions",
      "args": { "action": "export", "file": "captions.srt" },
      "expect_error": "fosscut.guard.destructive"
    },
    {
      "about": "Export the captioned short as a job.",
      "tool": "export",
      "args": { "output": "Short.mp4", "expected_revision": "${rev}", "request_id": "export" },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "report.verified.video.width": 1080,
        "report.verified.video.height": 1920,
        "report.verified.audio.codec": "aac"
      }
    }
  ]
}
