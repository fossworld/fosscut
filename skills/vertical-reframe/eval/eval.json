{
  "skill": "vertical-reframe",
  "about": "The reframe flow of SKILL.md on two generated shots whose subject, a white square, sits at the left in the first and at the right in the second, scripted through fosscut mcp: copy onto a 9:16 canvas with fill, find the cut, split, frame each shot with the skill's formula, check frames and export the vertical timeline. The canvas is small so the export stays quick on software encoders.",
  "fixtures": [
    {
      "file": "shots.mp4",
      "about": "3 s at 640x360 and 30 fps: a blue shot with a white square at x 60 to 140, then a plum shot with it at x 500 to 580, cut at frame 45, with a 440 Hz tone; generated by FFmpeg.",
      "ffmpeg": [
        "-f", "lavfi", "-i", "color=c=0x203050:s=640x360:r=30:d=1.5,drawbox=x=60:y=140:w=80:h=80:color=white:t=fill[a];color=c=0x503040:s=640x360:r=30:d=1.5,drawbox=x=500:y=140:w=80:h=80:color=white:t=fill[b];[a][b]concat=n=2:v=1:a=0",
        "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000:duration=3",
        "-c:v", "mpeg4", "-q:v", "3", "-c:a", "aac", "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "The wide project.",
      "tool": "project_new",
      "args": { "path": "Wide.fosscut", "width": 640, "height": 360 },
      "expect": { "revision": 0 }
    },
    {
      "about": "Import the shots.",
      "tool": "media_import",
      "args": { "files": ["shots.mp4"] },
      "save": { "asset": "results.0.asset" }
    },
    {
      "about": "Place them.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }],
        "request_id": "place"
      }
    },
    {
      "about": "Copy onto a 9:16 canvas that the pictures fill.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "timeline.duplicate", "args": { "width": 360, "height": 640, "fit": "fill", "name": "Vertical" } }],
        "request_id": "vertical"
      },
      "expect": { "results.0.primary": false },
      "save": { "vertical": "results.0.timeline" }
    },
    {
      "about": "Find the shots.",
      "tool": "media_analyze",
      "args": { "asset": "${asset}", "analyzers": ["scenes"], "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": { "state": "succeeded", "analysis.results.scenes.cuts.0.frame": 45 },
      "save": { "cut": "analysis.results.scenes.cuts.0.time.seconds" }
    },
    {
      "about": "The vertical copy's clip and its fill scale (about 3.16).",
      "tool": "timeline_read",
      "args": { "timeline": "${vertical}", "detail": "full" },
      "save": { "clip": "tracks.0.clips.0.id", "rev": "revision" }
    },
    {
      "about": "Split the vertical copy at the cut.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.split", "args": { "clip": "${clip}", "at": { "seconds": "${cut}" } } }],
        "expected_revision": "${rev}",
        "request_id": "split"
      },
      "save": { "second": "results.0.right.clip", "rev": "revision" }
    },
    {
      "about": "Frame each shot: the subject's centre is at u = 0.156 then 0.844, so x = -(u - 0.5) * 3.16, kept within (3.16 - 1) / 2 = 1.08.",
      "tool": "edit",
      "args": {
        "commands": [
          { "command": "clip.set", "args": { "clip": "${clip}", "set": { "transform.position": [1.08, 0] } } },
          { "command": "clip.set", "args": { "clip": "${second}", "set": { "transform.position": [-1.08, 0] } } }
        ],
        "expected_revision": "${rev}",
        "request_id": "frame-shots"
      },
      "expect": { "results.0.transform.position": [1.08, 0.0], "results.1.transform.position": [-1.08, 0.0] },
      "save": { "rev": "revision" }
    },
    {
      "about": "Check the first shot.",
      "tool": "frame_grab",
      "args": { "time": { "seconds": "0.7" }, "timeline": "${vertical}", "width": 180 },
      "expect_image": { "width": 180, "height": 320 }
    },
    {
      "about": "Check the whole vertical version.",
      "tool": "contact_sheet",
      "args": { "timeline": "${vertical}", "count": 4, "width": 90 }
    },
    {
      "about": "Export the vertical timeline.",
      "tool": "export",
      "args": { "output": "Vertical.mp4", "timeline": "${vertical}", "expected_revision": "${rev}", "request_id": "export" },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "report.verified.video.width": 360,
        "report.verified.video.height": 640
      }
    }
  ]
}
