{
  "skill": "vertical-reframe",
  "about": "The region path of SKILL.md on two generated shots whose subject, a white square, sits at the left in the first and at the right in the second, scripted through fosscut mcp: copy onto a 9:16 canvas with fill, split the copy at its scene cut, follow the square in each shot from its region, check frames and export the vertical timeline. The automatic path needs the pose model and footage of people, which the engine and CLI tests cover with cached analyses. The canvas is small so the export stays quick on software encoders.",
  "fixtures": [
    {
      "file": "shots.mp4",
      "about": "3 s at 640x360 and 30 fps: a blue shot with a white square at x 60 to 140, then a plum shot with it at x 500 to 580, cut at frame 45, with a 440 Hz tone; generated by FFmpeg.",
      "ffmpeg": [
        "-f", "lavfi", "-i",
        "color=c=0x203050:s=640x360:r=30:d=1.5,drawbox=x=60:y=140:w=80:h=80:color=white:t=fill[a];color=c=0x503040:s=640x360:r=30:d=1.5,drawbox=x=500:y=140:w=80:h=80:color=white:t=fill[b];[a][b]concat=n=2:v=1:a=0",
        "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000:duration=3", "-c:v", "mpeg4", "-q:v", "3",
        "-c:a", "aac", "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "The wide project.",
      "tool": "project_new",
      "args": { "path": "Wide.fosscut", "width": 640, "height": 360 },
      "expect": { "revision": 0 }
    },
    {
      "about": "Import the shots.",
      "tool": "media_import",
      "args": { "files": ["shots.mp4"] },
      "save": { "asset": "results.0.asset" }
    },
    {
      "about": "Place them.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }],
        "request_id": "place"
      }
    },
    {
      "about": "Copy onto a 9:16 canvas that the pictures fill.",
      "tool": "edit",
      "args": {
        "commands": [
          {
            "command": "timeline.duplicate",
            "args": { "width": 360, "height": 640, "fit": "fill", "name": "Vertical" }
          }
        ],
        "request_id": "vertical"
      },
      "expect": { "results.0.primary": false },
      "save": { "vertical": "results.0.timeline" }
    },
    {
      "about": "The copy's clip.",
      "tool": "timeline_read",
      "args": { "timeline": "${vertical}", "detail": "full" },
      "save": { "copy": "tracks.0.clips.0.id" }
    },
    {
      "about": "Split the copy at its scene cut, so each shot is a clip.",
      "tool": "auto_edit",
      "args": { "action": "split_scenes", "clip": "${copy}", "request_id": "split" },
      "expect": { "committed": true, "scenes.cuts": { "$len": 1 } }
    },
    {
      "about": "The copy's two shots.",
      "tool": "timeline_read",
      "args": { "timeline": "${vertical}", "detail": "full" },
      "expect": { "tracks.0.clips": { "$len": 2 } },
      "save": { "first": "tracks.0.clips.0.id", "second": "tracks.0.clips.1.id", "rev": "revision" }
    },
    {
      "about": "Where the square is in the first shot of the wide picture: its centre at 0.156 across, 0.5 down, 0.125 wide and 0.222 high.",
      "tool": "frame_grab",
      "args": { "time": { "seconds": "0.5" }, "width": 320 },
      "expect_image": { "width": 320, "height": 180 }
    },
    {
      "about": "Follow it in the first shot.",
      "tool": "auto_edit",
      "args": {
        "action": "reframe",
        "clip": "${first}",
        "region": { "x": 0.156, "y": 0.5, "width": 0.125, "height": 0.222 },
        "at": "0s",
        "shots": false,
        "expected_revision": "${rev}",
        "request_id": "frame-first"
      },
      "expect": {
        "committed": true,
        "framing.clip": "${first}",
        "framing.frames": 45,
        "framing.subject_frames": 45
      },
      "save": { "rev": "revision" }
    },
    {
      "about": "And at the right in the second shot.",
      "tool": "auto_edit",
      "args": {
        "action": "reframe",
        "clip": "${second}",
        "region": { "x": 0.844, "y": 0.5, "width": 0.125, "height": 0.222 },
        "at": "1.5s",
        "shots": false,
        "expected_revision": "${rev}",
        "request_id": "frame-second"
      },
      "expect": {
        "committed": true,
        "framing.clip": "${second}",
        "framing.frames": 45,
        "framing.subject_frames": 45
      },
      "save": { "rev": "revision" }
    },
    {
      "about": "Check the first shot.",
      "tool": "frame_grab",
      "args": { "time": { "seconds": "0.7" }, "timeline": "${vertical}", "width": 180 },
      "expect_image": { "width": 180, "height": 320 }
    },
    {
      "about": "Check the whole vertical version.",
      "tool": "contact_sheet",
      "args": { "timeline": "${vertical}", "count": 4, "width": 90 }
    },
    {
      "about": "Export the vertical timeline.",
      "tool": "export",
      "args": {
        "output": "Vertical.mp4",
        "timeline": "${vertical}",
        "expected_revision": "${rev}",
        "request_id": "export"
      },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "report.verified.video.width": 360,
        "report.verified.video.height": 640
      }
    }
  ]
}
