{
  "skill": "long-to-shorts",
  "about": "The shorts flow of SKILL.md on a long take of read speech, scripted through fosscut mcp: transcribe and measure, score candidates, build a vertical short of the best one with captions and a title, check it and export it. Framing on a person needs the pose model and footage of people, which the engine tests cover with cached analyses, so the short keeps its picture centred. The canvas is small so the export stays quick on software encoders.",
  "needs": ["speech"],
  "fixtures": [
    {
      "file": "speech.flac",
      "about": "LibriSpeech 5105-28233-0005 (CC BY 4.0), committed with its license record.",
      "copy": "fixtures/speech/librispeech-5105-28233-0005/audio.flac"
    },
    {
      "file": "talk.mp4",
      "about": "The speech three times with a second of silence between, under a 640x360 test pattern, generated by FFmpeg.",
      "ffmpeg": [
        "-i", "speech.flac", "-f", "lavfi", "-i", "testsrc2=size=640x360:rate=30:duration=36.3", "-filter_complex",
        "aevalsrc=0:s=16000:d=1[s1];aevalsrc=0:s=16000:d=1[s2];[0:a]asplit=3[a][b][c];[a][s1][b][s2][c]concat=n=5:v=0:a=1[speech]",
        "-map", "1:v", "-map", "[speech]", "-c:v", "mpeg4", "-q:v", "5", "-c:a", "aac", "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "A project for the long take.",
      "tool": "project_new",
      "args": { "path": "Talk.fosscut", "width": 640, "height": 360 },
      "expect": { "revision": 0 }
    },
    {
      "about": "Import the take.",
      "tool": "media_import",
      "args": { "files": ["talk.mp4"] },
      "save": { "asset": "results.0.asset" }
    },
    {
      "about": "Place it.",
      "tool": "edit",
      "args": { "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }], "request_id": "place" },
      "save": { "clip": "results.0.clip" }
    },
    {
      "about": "Transcribe it and measure its loudness over time and its shots.",
      "tool": "media_analyze",
      "args": { "asset": "${asset}", "analyzers": ["transcript", "levels", "scenes"], "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": { "state": "succeeded" }
    },
    {
      "about": "Score the candidates between 5 and 30 seconds.",
      "tool": "auto_edit",
      "args": { "action": "short_candidates", "clip": "${clip}", "min_seconds": 5, "max_seconds": 30, "count": 3 },
      "expect": { "shorts.candidates": { "$min_len": 1 }, "shorts.missing": { "$len": 0 } },
      "save": {
        "from": "shorts.candidates.0.span.start.seconds",
        "to": "shorts.candidates.0.span.end.seconds"
      }
    },
    {
      "about": "Plan the short of the best candidate.",
      "tool": "auto_edit",
      "args": {
        "action": "make_short", "clip": "${clip}", "from": { "seconds": "${from}" }, "to": { "seconds": "${to}" },
        "subject": "centre", "width": 360, "height": 640, "name": "Short 1", "caption_preset": "bold-pop",
        "title": "Wander the shore", "dry_run": true
      },
      "expect": { "dry_run": true }
    },
    {
      "about": "Build it.",
      "tool": "auto_edit",
      "args": {
        "action": "make_short", "clip": "${clip}", "from": { "seconds": "${from}" }, "to": { "seconds": "${to}" },
        "subject": "centre", "width": 360, "height": 640, "name": "Short 1", "caption_preset": "bold-pop",
        "title": "Wander the shore", "request_id": "short-1"
      },
      "expect": { "committed": true, "short.name": "Short 1" },
      "save": { "short": "short.timeline", "rev": "revision" }
    },
    {
      "about": "The short is a vertical timeline of its own.",
      "tool": "timeline_read",
      "args": { "timeline": "${short}" },
      "expect": { "format.width": 360, "format.height": 640, "name": "Short 1", "tracks": { "$min_len": 3 } }
    },
    {
      "about": "Check the title and captions.",
      "tool": "frame_grab",
      "args": { "time": { "seconds": "1" }, "timeline": "${short}", "width": 180 },
      "expect_image": { "width": 180, "height": 320 }
    },
    {
      "about": "Check the whole short.",
      "tool": "contact_sheet",
      "args": { "timeline": "${short}", "count": 4, "width": 90 }
    },
    {
      "about": "Export the short.",
      "tool": "export",
      "args": { "output": "Short 1.mp4", "timeline": "${short}", "expected_revision": "${rev}", "request_id": "export" },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": { "state": "succeeded", "report.verified.video.width": 360, "report.verified.video.height": 640 }
    }
  ]
}
