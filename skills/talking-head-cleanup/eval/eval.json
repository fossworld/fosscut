{
  "skill": "talking-head-cleanup",
  "about": "The cleanup flow of SKILL.md on read speech with two long silences inserted, scripted through fosscut mcp: transcribe, plan the pause cuts from the transcript, dry run, meet the destructive guard, apply as one undoable step, check a join and export. The eval cuts whole pauses because steps cannot do arithmetic; the skill keeps a breath at each end.",
  "needs": ["speech"],
  "fixtures": [
    {
      "file": "speech.flac",
      "about": "LibriSpeech 5105-28233-0005 (CC BY 4.0), committed with its license record.",
      "copy": "fixtures/speech/librispeech-5105-28233-0005/audio.flac"
    },
    {
      "file": "talk.mp4",
      "about": "The speech with 1.5 s of silence added inside its first pause (at 3.6 s) and 1.2 s inside its second (at 7.2 s), under a 640x360 test pattern, generated by FFmpeg.",
      "ffmpeg": [
        "-i", "speech.flac",
        "-f", "lavfi", "-i", "testsrc2=size=640x360:rate=30:duration=14.1",
        "-filter_complex",
        "[0:a]atrim=0:3.6,asetpts=PTS-STARTPTS[a];aevalsrc=0:s=16000:d=1.5[s1];[0:a]atrim=3.6:7.2,asetpts=PTS-STARTPTS[b];aevalsrc=0:s=16000:d=1.2[s2];[0:a]atrim=7.2,asetpts=PTS-STARTPTS[c];[a][s1][b][s2][c]concat=n=5:v=0:a=1[speech]",
        "-map", "1:v", "-map", "[speech]",
        "-c:v", "mpeg4", "-q:v", "5", "-c:a", "aac", "-shortest"
      ]
    }
  ],
  "steps": [
    {
      "about": "A project for the talk.",
      "tool": "project_new",
      "args": { "path": "Talk.fosscut", "width": 640, "height": 360 },
      "expect": { "revision": 0 }
    },
    {
      "about": "Import the talk.",
      "tool": "media_import",
      "args": { "files": ["talk.mp4"] },
      "save": { "asset": "results.0.asset" }
    },
    {
      "about": "Place it at the start of the timeline, so asset and timeline times agree.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "clip.add", "args": { "asset": "${asset}" } }],
        "request_id": "place-talk"
      },
      "save": { "rev": "revision" }
    },
    {
      "about": "Transcribe: words, fillers and pauses.",
      "tool": "media_analyze",
      "args": {
        "asset": "${asset}",
        "analyzers": ["transcript"],
        "options": { "transcript": { "model": "whisper-tiny.en" } },
        "wait_seconds": 60
      },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "analysis.results.transcript.pauses": { "$min_len": 2 }
      },
      "save": {
        "p0s": "analysis.results.transcript.pauses.0.start.seconds",
        "p0e": "analysis.results.transcript.pauses.0.end.seconds",
        "p1s": "analysis.results.transcript.pauses.1.start.seconds",
        "p1e": "analysis.results.transcript.pauses.1.end.seconds"
      }
    },
    {
      "about": "Dry run of the planned cuts.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "timeline.remove_ranges", "args": { "ranges": [
          { "start": { "seconds": "${p0s}" }, "end": { "seconds": "${p0e}" } },
          { "start": { "seconds": "${p1s}" }, "end": { "seconds": "${p1e}" } }
        ] } }],
        "expected_revision": "${rev}",
        "allow_destructive": true,
        "dry_run": true
      },
      "expect": { "dry_run": true, "results.0.ranges": { "$len": 2 } }
    },
    {
      "about": "Cutting the main footage is refused without the user's permission.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "timeline.remove_ranges", "args": { "ranges": [
          { "start": { "seconds": "${p0s}" }, "end": { "seconds": "${p0e}" } }
        ] } }],
        "expected_revision": "${rev}"
      },
      "expect_error": "fosscut.guard.destructive"
    },
    {
      "about": "Apply the approved cuts as one step.",
      "tool": "edit",
      "args": {
        "commands": [{ "command": "timeline.remove_ranges", "args": { "ranges": [
          { "start": { "seconds": "${p0s}" }, "end": { "seconds": "${p0e}" } },
          { "start": { "seconds": "${p1s}" }, "end": { "seconds": "${p1e}" } }
        ] } }],
        "expected_revision": "${rev}",
        "allow_destructive": true,
        "request_id": "cut-pauses",
        "reason": "remove long pauses"
      },
      "expect": { "committed": true, "results.0.clips_added": { "$len": 2 } },
      "save": { "rev": "revision" }
    },
    {
      "about": "The talk is now three segments.",
      "tool": "timeline_read",
      "args": { "detail": "normal" },
      "expect": { "tracks.0.clips": { "$len": 3 } }
    },
    {
      "about": "Look at the first join.",
      "tool": "frame_grab",
      "args": { "time": { "seconds": "${p0s}" }, "width": 320 },
      "expect_image": { "width": 320, "height": 180 }
    },
    {
      "about": "Export the tightened talk.",
      "tool": "export",
      "args": { "output": "Tight.mp4", "expected_revision": "${rev}", "request_id": "export" },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": {
        "state": "succeeded",
        "report.verified.video.width": 640,
        "report.verified.audio.codec": "aac"
      }
    }
  ]
}
