{
  "skill": "beat-sync",
  "about": "The beat flow of SKILL.md on generated clicks at 120 bpm and three shots cut just off the beats, scripted through fosscut mcp: mark the bars, plan the cuts with a dry run, move them onto the beats, check a cut and export. The canvas is small so the export stays quick on software encoders.",
  "fixtures": [
    {
      "file": "clicks.wav",
      "about": "8 s of 2 kHz clicks at 120 bpm from 0.2 s, every fourth one louder, generated by FFmpeg.",
      "ffmpeg": [
        "-f", "lavfi", "-i",
        "aevalsrc='gte(t,0.2)*(0.4+0.4*eq(mod(floor((t-0.2)/0.5),4),0))*sin(2*PI*2000*t)*exp(-mod(t-0.2,0.5)/0.0015)':s=48000:d=8",
        "-c:a", "pcm_s16le"
      ]
    },
    {
      "file": "shots.mp4",
      "about": "4 s of a 320x180 test pattern at 30 fps, generated by FFmpeg.",
      "ffmpeg": ["-f", "lavfi", "-i", "testsrc2=s=320x180:r=30:d=4", "-c:v", "mpeg4", "-q:v", "3"]
    }
  ],
  "steps": [
    {
      "about": "A project for the montage.",
      "tool": "project_new",
      "args": { "path": "Montage.fosscut", "width": 320, "height": 180 },
      "expect": { "revision": 0 }
    },
    {
      "about": "Import the music and the shots.",
      "tool": "media_import",
      "args": { "files": ["clicks.wav", "shots.mp4"] },
      "save": { "music_asset": "results.0.asset", "shots": "results.1.asset" }
    },
    {
      "about": "Three shots cut at 1.1 s and 2.3 s, just off the beats at 1.2 and 2.2, over the music.",
      "tool": "edit",
      "args": {
        "commands": [
          { "command": "clip.add", "args": { "asset": "${shots}", "start": "0s", "duration": "33f" } },
          { "command": "clip.add", "args": { "asset": "${shots}", "start": "33f", "source_in": "1s", "duration": "36f" } },
          { "command": "clip.add", "args": { "asset": "${shots}", "start": "69f", "source_in": "1s", "duration": "30f" } },
          { "command": "clip.add", "args": { "asset": "${music_asset}", "start": "0s" } }
        ],
        "request_id": "place"
      },
      "save": { "track": "results.0.track", "music": "results.3.clip" }
    },
    {
      "about": "Mark the bars.",
      "tool": "auto_edit",
      "args": { "action": "beat_markers", "music": "${music}", "every": 4, "request_id": "bars" },
      "expect": { "committed": true, "beats.beats_per_bar": 4, "beats.at": { "$len": 4 } }
    },
    {
      "about": "Plan moving the cuts onto the beats.",
      "tool": "auto_edit",
      "args": { "action": "beat_cuts", "track": "${track}", "music": "${music}", "dry_run": true },
      "expect": { "dry_run": true, "beats.snapped": { "$len": 2 }, "beats.unsnapped": { "$len": 0 } }
    },
    {
      "about": "The revision to apply at.",
      "tool": "timeline_read",
      "args": {},
      "save": { "rev": "revision" }
    },
    {
      "about": "Apply the plan.",
      "tool": "auto_edit",
      "args": { "action": "beat_cuts", "track": "${track}", "music": "${music}", "expected_revision": "${rev}", "request_id": "cuts" },
      "expect": { "committed": true, "beats.snapped": { "$len": 2 } },
      "save": { "rev": "revision" }
    },
    {
      "about": "The cuts are on the beats at frames 36 and 66, and the edit keeps its length.",
      "tool": "timeline_read",
      "args": { "detail": "full" },
      "expect": {
        "tracks.0.clips.0.duration.frames": 36,
        "tracks.0.clips.1.start.frames": 36,
        "tracks.0.clips.2.start.frames": 66,
        "tracks.0.clips.2.duration.frames": 33,
        "markers": { "$len": 4 }
      }
    },
    {
      "about": "Check both sides of the second cut.",
      "tool": "frame_grab",
      "args": { "time": { "frames": 66 }, "width": 160 },
      "expect_image": { "width": 160, "height": 90 }
    },
    {
      "about": "Export the montage.",
      "tool": "export",
      "args": { "output": "Montage.mp4", "expected_revision": "${rev}", "request_id": "export" },
      "save": { "job": "job" }
    },
    {
      "about": "Wait for the job and verify the report.",
      "tool": "job_status",
      "args": { "job": "${job}", "wait_seconds": 60 },
      "repeat_while": { "state": "running" },
      "expect": { "state": "succeeded", "report.verified.video.width": 320 }
    }
  ]
}
