{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core events and the app's own commands, nothing else",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-recent-projects",
    "allow-project-current",
    "allow-project-open",
    "allow-project-pick",
    "allow-project-new",
    "allow-project-close",
    "allow-query",
    "allow-execute",
    "allow-clients",
    "allow-color-suggest",
    "allow-audio-normalize",
    "allow-scenes-split",
    "allow-clip-stabilize",
    "allow-clip-track",
    "allow-multicam-create",
    "allow-preview-viewport",
    "allow-preview-show",
    "allow-preview-play",
    "allow-preview-pause",
    "allow-preview-shuttle",
    "allow-window-fullscreen",
    "allow-media-reveal",
    "allow-media-relink",
    "allow-project-summaries",
    "allow-project-trash",
    "allow-trash-list",
    "allow-trash-restore",
    "allow-trash-delete",
    "allow-library-list",
    "allow-library-add",
    "allow-export-presets",
    "allow-export-pick",
    "allow-export-start",
    "allow-export-status",
    "allow-export-cancel",
    "allow-record-devices",
    "allow-record-start",
    "allow-record-status",
    "allow-record-stop",
    "allow-preferences-get",
    "allow-preferences-set",
    "allow-preferences-reset",
    "allow-update-check",
    "allow-update-open",
    "allow-sound-play",
    "allow-folder-pick",
    "allow-cache-info",
    "allow-cache-clear",
    "allow-media-sources",
    "allow-media-work"
  ]
}
