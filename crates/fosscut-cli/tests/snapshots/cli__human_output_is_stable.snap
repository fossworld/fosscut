---
source: crates/fosscut-cli/tests/cli.rs
expression: text
---
$ fosscut project new Demo.fosscut --name Demo
Demo (project_<random>)  revision 0  format 0.2.0
assets: 0  can undo: false  can redo: false
  timeline_0000 Timeline 1 (primary): 1920x1080 @ 30 fps, 0 tracks, 0 clips, 00:00:00:00

$ fosscut text add Hello --duration 2s
saved revision 1
  clip_0002 on track_0001: 00:00:00:00 – 00:00:02:00 (60 frames)
  changes: + clip_0002, track_0001

$ fosscut text add World --start 3s --duration 1s --dry-run
dry run, nothing saved (revision 1)
  clip_0003 on track_0001: 00:00:03:00 – 00:00:04:00 (30 frames)
  changes: + clip_0003

$ fosscut text add World --start 3s --duration 1s --request-id world
saved revision 2
  clip_0003 on track_0001: 00:00:03:00 – 00:00:04:00 (30 frames)
  changes: + clip_0003

$ fosscut text add World --start 3s --duration 1s --request-id world
replayed earlier request, revision 2
  clip_0003 on track_0001: 00:00:03:00 – 00:00:04:00 (30 frames)
  changes: + clip_0003

$ fosscut text add Overlap --start 3s --duration 1s
[exit 1]
error: the clip would overlap clip_0003 on track track_0001 [fosscut.clip.overlap]
hint: Choose a free position (details.free_from), another track, or remove the other clip first.
details: {"command":"text.add","command_index":0,"conflicting_clip":"clip_0003","conflicting_end":{"flicks":2822400000,"frames":120,"seconds":"4","timecode":"00:00:04:00"},"conflicting_start":{"flicks":2116800000,"frames":90,"seconds":"3","timecode":"00:00:03:00"},"free_from":{"flicks":2822400000,"frames":120,"seconds":"4","timecode":"00:00:04:00"}}

$ fosscut track add --kind text --name Captions
saved revision 3
  track_0004 at index 1
  changes: + track_0004

$ fosscut clip move --clip clip_0002 --start 5s
saved revision 4
  clip_0002 on track_0001: 00:00:05:00 – 00:00:07:00 (60 frames)
  changes: ~ clip_0002

$ fosscut clip move --clip clip_0002 --start 5s
no changes (revision 4)
  clip_0002 on track_0001: 00:00:05:00 – 00:00:07:00 (60 frames)

$ fosscut clip move --clip clip_0099 --start 1s
[exit 1]
error: clip clip_0099 does not exist [fosscut.clip.not_found]
hint: Read the timeline to get current clip ids.
details: {"command":"clip.move","command_index":0}

$ fosscut clip split --clip clip_0002 --at 6s
saved revision 5
  split: clip_0002 00:00:05:00 – 00:00:06:00 (30 frames)  |  clip_0005 00:00:06:00 – 00:00:07:00 (30 frames)
  changes: + clip_0005 ~ clip_0002

$ fosscut clip remove --clip clip_0005
saved revision 6
  removed clip_0005 from track_0001
  changes: - clip_0005

$ fosscut undo
saved revision 7
  history entry 6
  changes: + clip_0005

$ fosscut redo
saved revision 8
  history entry 6
  changes: - clip_0005

$ fosscut timeline read
