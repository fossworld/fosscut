  clip_0003 text  00:00:03:00 – 00:00:04:00 (30 frames)  "World"
  clip_0002 text  00:00:05:00 – 00:00:06:00 (30 frames)  "Hello"
track_0004 text  (0 clips, ends 00:00:00:00)

