---
source: crates/fosscut-mcp/tests/server.rs
expression: listing
---
[
  {
    "description": "List what FossCut can do: every editing command and query with a summary, the engine operations, the analyzers, the models and whether each is installed, and the export presets this machine can encode. Before using a command the first time, call it with names (for example [\"clip.add\", \"text.add\"]) to get just those argument schemas; detail: full returns every schema and error code at once and is large.",
    "input": {
      "$defs": {
        "Detail": {
          "description": "How much `capabilities` and `timeline_read` include.",
          "oneOf": [
            {
              "const": "outline",
              "description": "Names and summaries only.",
              "type": "string"
            },
            {
              "const": "normal",
              "description": "Everything except schemas.",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Everything, including JSON Schemas.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "detail": {
          "$ref": "#/$defs/Detail",
          "description": "`outline` (default) lists names and summaries; `full` adds every command's JSON\nSchema, the request and time schemas, and the error codes (large)."
        },
        "names": {
          "default": [],
          "description": "Only these commands and queries, each with its argument JSON Schema, for example\n`[\"clip.add\", \"text.add\"]`. Ask for the commands you are about to use.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "name": "capabilities",
    "read_only": true
  },
  {
    "description": "Render frames spread evenly over the timeline into one PNG grid (default 12 frames, 240 pixels wide each), to check a whole edit at a glance. Returns the image and each tile's time and position.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "Frames to show, 1 to 100 (default 12), from the middle of equal parts of the\ntimeline.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "description": "Timeline id; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "Width of each frame in pixels (default 240).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "contact_sheet",
    "read_only": true
  },
  {
    "description": "Change the project: apply one or more commands (clip.add, clip.split, clip.move, clip.remove, text.add, track.add and others from capabilities) in order as one atomic transaction and one undo step. Pass expected_revision from your last read; dry_run: true reports the changes without committing; a request_id makes retries safe. Returns the new revision, each command's result and a summary of changes.",
    "input": {
      "$defs": {
        "CommandCall": {
          "additionalProperties": false,
          "description": "One command invocation inside a request.",
          "properties": {
            "args": {
              "default": null,
              "description": "Arguments matching the command's input schema."
            },
            "command": {
              "description": "Command name, for example `clip.split`.",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allow_destructive": {
          "default": false,
          "description": "Allow destructive changes such as removing clips from the main video track. Ask the\nuser first.",
          "type": "boolean"
        },
        "commands": {
          "description": "Commands applied in order as one transaction and one undo step, for example\n`[{\"command\": \"clip.split\", \"args\": {\"clip\": \"clip_0003\", \"at\": {\"timecode\": \"00:00:03:28\"}}}]`.\n`capabilities` with `detail: full` gives each command's argument schema.",
          "items": {
            "$ref": "#/$defs/CommandCall"
          },
          "type": "array"
        },
        "dry_run": {
          "default": false,
          "description": "Validate and report the changes without committing them.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision; pass\nthe revision from your last read.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key: repeating it with the same commands returns the first result instead of\napplying them twice.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "commands"
      ],
      "type": "object"
    },
    "name": "edit",
    "read_only": false
  },
  {
    "description": "Export the timeline to a video or audio file in the background and return a job id at once; then call job_status with wait_seconds until the job succeeds. The file is probed and checked against the request (codec, size, rate, frame count, duration, audio); a codec this machine cannot encode fails with the codecs that work instead, never a substitute. dry_run: true checks everything and reports frames, duration and encoders without writing.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allow_destructive": {
          "default": false,
          "description": "Replace the output if it exists. Ask the user first.",
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "description": "Check everything and report frames, duration and encoders without writing.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision, so the\nexport matches the edit you checked.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "description": "File to write, for example `Promo.mp4`.",
          "type": "string"
        },
        "preset": {
          "description": "`mp4-h264`, `mp4-hevc`, `mp4-av1`, `mov-prores`, `webm-vp9` or `m4a-aac`. When\nomitted the extension decides: `.mov` ProRes, `.webm` VP9, `.m4a` audio only, and\nanything else the most compatible video preset this machine can encode.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key: repeating it returns the running or finished export.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "description": "Timeline id; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "output"
      ],
      "type": "object"
    },
    "name": "export",
    "read_only": false
  },
  {
    "description": "Render the frame of the timeline at a time as a PNG image, exactly as the export will show it (default 640 pixels wide). Use it to check titles, placement and cuts. Returns the image and the frame's time in every unit.",
    "input": {
      "$defs": {
        "TimeInput": {
          "description": "A time with an explicit unit. Frame and timecode values use the timeline frame rate. Bare numbers are rejected.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "frames": {
                  "type": "integer"
                }
              },
              "required": [
                "frames"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "seconds": {
                  "description": "Decimal seconds, for example \"3.9333\"",
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "seconds"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "timecode": {
                  "description": "HH:MM:SS:FF, or HH:MM:SS;FF for drop-frame",
                  "type": "string"
                }
              },
              "required": [
                "timecode"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "flicks": {
                  "type": "integer"
                }
              },
              "required": [
                "flicks"
              ],
              "type": "object"
            },
            {
              "description": "Shorthand: 118f, 3.9333s, 00:00:03:28 or 2775360000fl",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "$ref": "#/$defs/TimeInput",
          "description": "The moment to show, with a unit: `{\"seconds\": \"1.5\"}`, `{\"frames\": 45}`,\n`{\"timecode\": \"00:00:01:15\"}` or `{\"flicks\": n}`."
        },
        "timeline": {
          "description": "Timeline id; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "Image width in pixels (default 640); the height keeps the aspect ratio.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "time"
      ],
      "type": "object"
    },
    "name": "frame_grab",
    "read_only": true
  },
  {
    "description": "List the project's recent changes, newest first: revision, who made it (human or agent:<name>), the commands and the reason.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "description": "Most recent entries to list (default 20).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "history",
    "read_only": true
  },
  {
    "description": "Cancel a running export job; nothing is written. A finished job is not affected. wait_seconds (up to 60) waits for it to stop.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "job": {
          "description": "Job id from `export`, for example `job_0001`.",
          "type": "string"
        },
        "wait_seconds": {
          "description": "Seconds to wait for the job to finish before answering, 0 to 60 (default 0).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "name": "job_cancel",
    "read_only": false
  },
  {
    "description": "The state of an export job (running, succeeded, failed or cancelled) with progress; when it succeeded, the verified export report; when it failed, the typed error. wait_seconds (up to 60) waits for the job to finish before answering.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "job": {
          "description": "Job id from `export`, for example `job_0001`.",
          "type": "string"
        },
        "wait_seconds": {
          "description": "Seconds to wait for the job to finish before answering, 0 to 60 (default 0).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "job"
      ],
      "type": "object"
    },
    "name": "job_status",
    "read_only": true
  },
  {
    "description": "Measure an asset's loudness (LUFS), silences (pauses to cut or keep) and shot cuts, or transcribe its speech (analyzers: [\"transcript\"]) into segments and words with start and end times, filler words such as um and uh, and pauses between words, all on this machine. Cached results come back at once; otherwise the measurement runs as a job and this waits up to wait_seconds (default 30) for it: if state is still running, follow it with job_status. Times are from the start of the asset's file, in flicks and seconds; map them to the timeline through the clip's source_in. options tunes thresholds, for example {\"silences\": {\"threshold_dbfs\": -35}}. A transcript needs a speech model: if none is installed, ask the user before installing one with models.",
    "input": {
      "$defs": {
        "Options": {
          "additionalProperties": false,
          "description": "Options for every analyzer; each has defaults.",
          "properties": {
            "scenes": {
              "$ref": "#/$defs/SceneOptions",
              "default": {
                "min_shot_ms": 500,
                "threshold": 0.35
              },
              "description": "Options of `scenes`."
            },
            "silences": {
              "$ref": "#/$defs/SilenceOptions",
              "default": {
                "min_duration_ms": 300,
                "threshold_dbfs": -40.0
              },
              "description": "Options of `silences`."
            },
            "transcript": {
              "$ref": "#/$defs/TranscriptOptions",
              "default": {
                "keep_fillers": true,
                "min_pause_ms": 300
              },
              "description": "Options of `transcript`."
            }
          },
          "type": "object"
        },
        "SceneOptions": {
          "additionalProperties": false,
          "description": "Options of the `scenes` analyzer.",
          "properties": {
            "min_shot_ms": {
              "default": 500,
              "description": "Shortest shot, in milliseconds: a cut sooner than this after the previous one (or\nthe start) is ignored (default 500).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "threshold": {
              "default": 0.35,
              "description": "Histogram change, from 0 to 1, that counts as a cut (default 0.35).",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "SilenceOptions": {
          "additionalProperties": false,
          "description": "Options of the `silences` analyzer.",
          "properties": {
            "min_duration_ms": {
              "default": 300,
              "description": "Shortest quiet run reported, in milliseconds (default 300).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "threshold_dbfs": {
              "default": -40.0,
              "description": "A window is quiet when its RMS level is below this, in dBFS (default -40).",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "TranscriptOptions": {
          "additionalProperties": false,
          "description": "Options of the `transcript` analyzer.",
          "properties": {
            "keep_fillers": {
              "default": true,
              "description": "Prompt the model to write fillers such as \"um\" instead of tidying them away\n(default true).",
              "type": "boolean"
            },
            "language": {
              "description": "Spoken language as a two-letter code such as `en`; detected when omitted, and always\nEnglish with English-only (`.en`) models.",
              "type": [
                "string",
                "null"
              ]
            },
            "min_pause_ms": {
              "default": 300,
              "description": "Gaps between words reported as pauses, in milliseconds (default 300).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "description": "Model name, for example `whisper-base.en`; the most capable installed speech model\nfor the language when omitted.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "analyzers": {
          "default": [],
          "description": "`loudness`, `silences`, `scenes` and/or `transcript`. When omitted, every analyzer the\nasset allows except `transcript`, which needs an installed speech model (see `models`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "asset": {
          "description": "The asset to analyze, for example `asset_0001` (from `media_list`).",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/Options",
          "default": {
            "scenes": {
              "min_shot_ms": 500,
              "threshold": 0.35
            },
            "silences": {
              "min_duration_ms": 300,
              "threshold_dbfs": -40.0
            },
            "transcript": {
              "keep_fillers": true,
              "min_pause_ms": 300
            }
          },
          "description": "Analyzer options, for example `{\"silences\": {\"threshold_dbfs\": -35, \"min_duration_ms\":\n400}}` or `{\"transcript\": {\"language\": \"en\", \"min_pause_ms\": 250}}`; defaults when\nomitted."
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh": {
          "default": false,
          "description": "Measure again even if results are cached.",
          "type": "boolean"
        },
        "wait_seconds": {
          "description": "Seconds to wait for a measurement to finish before answering, 0 to 60 (default 30).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "name": "media_analyze",
    "read_only": true
  },
  {
    "description": "Import video, audio or image files into the project's media table in one revision. Returns each new asset id (asset_...), which clip.add uses. Importing a file that is already in the project returns its existing asset.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Report what would be added without changing the project.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "files": {
          "description": "Media files to import: video, audio or images. All are added in one revision.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key: repeating it with the same files returns the first result.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "name": "media_import",
    "read_only": false
  },
  {
    "description": "List the project's media: asset ids, names, kinds, durations and stream details.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "media_list",
    "read_only": true
  },
  {
    "description": "List the models analyzers can use (speech recognition for media_analyze transcript) with size, license, languages and whether each is installed, or install one. Installing downloads it and checks its SHA-256: tell the user the size and license first, and pass confirm: true only after they agree. Larger models are more accurate and slower; English-only models (.en) suit English speech.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confirm": {
          "default": false,
          "description": "`true` only after the user agreed to the download size and license.",
          "type": "boolean"
        },
        "from": {
          "description": "Install from this local file instead of downloading; it is verified the same way.",
          "type": [
            "string",
            "null"
          ]
        },
        "install": {
          "description": "The model to install, for example `whisper-base.en`; omit to list the models.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "models",
    "read_only": false
  },
  {
    "description": "Project name, current revision, timelines with their formats, and whether undo or redo is possible.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "project_info",
    "read_only": true
  },
  {
    "description": "Create a new project bundle (a directory ending in .fosscut) with an empty timeline, and make it the open project. Defaults: 1920x1080 at 30 fps; use width 1080 and height 1920 for vertical video. Returns project info.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "height": {
          "description": "Timeline height in pixels (default 1080; 1920 for vertical video).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Project name; the directory name when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Bundle directory to create, for example `Promo.fosscut`. It must not exist or must\nbe empty.",
          "type": "string"
        },
        "rate": {
          "description": "Frame rate, for example `30`, `25` or `30000/1001` (default 30).",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "Timeline width in pixels (default 1920; 1080 for vertical video).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "project_new",
    "read_only": false
  },
  {
    "description": "Open an existing .fosscut project; later tools use it when they get no project argument. Returns project info: name, revision, timelines and undo state.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "description": "Path of an existing `.fosscut` bundle.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "project_open",
    "read_only": true
  },
  {
    "description": "Run any read-only query from capabilities by name with its arguments, for queries no other tool covers.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "args": {
          "description": "Query arguments matching its schema."
        },
        "name": {
          "description": "Query name from `capabilities`, for example `history.list`.",
          "type": "string"
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
