  {
    "description": "FossCut's own library, made by FossCut and free to use, also commercially: shapes, stickers (badges, buttons, arrows, bubbles), backgrounds (solid and gradient), project templates, title templates, text and caption styles, looks, sound effects and music loops. action list (with kind and search) lists items; action add puts one in the project: sounds and music are imported and placed at start, shapes, stickers and backgrounds drawn, titles and templates added with lines and media, styles and looks applied (looks need clip). One undoable step with expected_revision, dry_run and request_id (sounds are imported in a step of their own first).",
    "input": {
      "$defs": {
        "LibraryAction": {
          "description": "What the `library` tool does.",
          "oneOf": [
            {
              "const": "list",
              "description": "List or search the library.",
              "type": "string"
            },
            {
              "const": "add",
              "description": "Add an item to the project.",
              "type": "string"
            }
          ]
        },
        "TimeInput": {
          "description": "A time with an explicit unit. Frame and timecode values use the timeline frame rate. Bare numbers are rejected.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "frames": {
                  "type": "integer"
                }
              },
              "required": [
                "frames"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "seconds": {
                  "description": "Decimal seconds, for example \"3.9333\"",
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "seconds"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "timecode": {
                  "description": "HH:MM:SS:FF, or HH:MM:SS;FF for drop-frame",
                  "type": "string"
                }
              },
              "required": [
                "timecode"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "flicks": {
                  "type": "integer"
                }
              },
              "required": [
                "flicks"
              ],
              "type": "object"
            },
            {
              "description": "Shorthand: 118f, 3.9333s, 00:00:03:28 or 2775360000fl",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/LibraryAction",
          "description": "`list` (with `kind` and `search`) or `add` (with `name`)."
        },
        "clip": {
          "description": "add: the clip a look applies to.",
          "type": [
            "string",
            "null"
          ]
        },
        "dry_run": {
          "default": false,
          "description": "Report what would change without committing it.",
          "type": "boolean"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "add: how long it lasts."
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "description": "Only, or the item's, kind: shape, sticker, background, template, title,\ntext_style, caption_style, look, sound or music.",
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "default": [],
          "description": "add: lines for titles and templates; the text of a text style's clip.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "media": {
          "default": [],
          "description": "add: assets for a template's slots.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "add: the item's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key.",
          "type": [
            "string",
            "null"
          ]
        },
        "search": {
          "description": "list: words to find in names, descriptions and tags.",
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "add: where it starts."
        },
        "track": {
          "description": "add: the track.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "library",
    "read_only": false
  },
  {
    "description": "Measure an asset's loudness (LUFS), its loudness over time (levels), silences (pauses to cut or keep), shot cuts (scenes) and musical beats (beats: tempo, beats and downbeats), or transcribe its speech (analyzers: [\"transcript\"]) into segments and words with start and end times, filler words such as um and uh, and pauses between words, all on this machine. Cached results come back at once; otherwise the measurement runs as a job and this waits up to wait_seconds (default 30) for it: if state is still running, follow it with job_status. Times are from the start of the asset's file, in flicks and seconds; map them to the timeline through the clip's source_in (and its speed, when timeline_read shows one). options tunes thresholds, for example {\"silences\": {\"threshold_dbfs\": -35}}. A transcript needs a speech model: if none is installed, ask the user before installing one with models. For video, analyzers [\"pose\"] finds a person's body landmarks and mask (for the body.* effects), and [\"matte\"] separates the subject for the key.subject effect: options {\"matte\": {\"model\": \"person\"}} is fast, \"subject\" (BiRefNet, any subject) takes seconds a frame, so use {\"every\": 5} on long clips; both need their models installed (mediapipe-pose-full, birefnet-lite, onnxruntime). Run them before adding those effects: exports and frame grabs refuse a clip whose analysis is missing.",
    "input": {
      "$defs": {
        "BeatOptions": {
          "additionalProperties": false,
          "description": "Options of the `beats` analyzer.",
          "properties": {
            "bpm": {
              "description": "A known tempo, used instead of estimating one.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "max_bpm": {
              "default": 220.0,
              "description": "Fastest tempo considered (default 220).",
              "format": "double",
              "type": "number"
            },
            "min_bpm": {
              "default": 50.0,
              "description": "Slowest tempo considered, in beats per minute (default 50).",
              "format": "double",
              "type": "number"
            },
            "prior_bpm": {
              "default": 120.0,
              "description": "The tempo the estimate leans towards when the music allows two, such as 60 or 120\nfor a 120 bpm song (default 120).",
              "format": "double",
              "type": "number"
            },
            "tightness": {
              "default": 100.0,
              "description": "How strictly beats keep an even tempo against following the onsets, from 1 to 1000\n(default 100).",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "LevelOptions": {
          "additionalProperties": false,
          "description": "Options of the `levels` analyzer.",
          "properties": {
            "window_ms": {
              "default": 1000,
              "description": "The window, in milliseconds, from 100 to 10000 (default 1000).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "MatteModel": {
          "description": "Which model makes a matte.",
          "oneOf": [
            {
              "const": "person",
              "description": "The pose model's person mask: people only, fast.",
              "type": "string"
            },
            {
              "const": "subject",
              "description": "BiRefNet: any subject, fine edges, slow.",
              "type": "string"
            }
          ]
        },
        "MatteOptions": {
          "additionalProperties": false,
          "description": "Options of the `matte` analyzer.",
          "properties": {
            "every": {
              "default": 1,
              "description": "Run the model on every `every`-th analyzed frame (1 to 300, default 1) and follow the\nsubject's motion in between: 5 to 10 keeps `subject` practical for slow scenes, at\nthe cost of soft edges where the subject changes shape quickly.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "max_fps": {
              "default": 30,
              "description": "Most frames analyzed per second, 1 to 60 (default 30).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "$ref": "#/$defs/MatteModel",
              "default": "person",
              "description": "`person` (the default: the pose model's person mask, about 20 ms a frame) or\n`subject` (BiRefNet: any subject with fine edges, 9 to 14 s a frame on a laptop CPU)."
            },
            "size": {
              "default": 512,
              "description": "The stored matte's longer side in pixels, 64 to 1024 (default 512).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "smoothing": {
              "default": 0.5,
              "description": "How much mattes are smoothed in time, from 0 (not at all) to 1 (a Gaussian of two\nframes); edges that move are left alone. Default 0.5.",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "Options": {
          "additionalProperties": false,
          "description": "Options for every analyzer; each has defaults.",
          "properties": {
            "beats": {
              "$ref": "#/$defs/BeatOptions",
              "default": {
                "max_bpm": 220.0,
                "min_bpm": 50.0,
                "prior_bpm": 120.0,
                "tightness": 100.0
              },
              "description": "Options of `beats`."
            },
            "levels": {
              "$ref": "#/$defs/LevelOptions",
              "default": {
                "window_ms": 1000
              },
              "description": "Options of `levels`."
            },
            "matte": {
              "$ref": "#/$defs/MatteOptions",
              "default": {
                "every": 1,
                "max_fps": 30,
                "model": "person",
                "size": 512,
                "smoothing": 0.5
              },
              "description": "Options of `matte`."
            },
            "pose": {
              "$ref": "#/$defs/PoseOptions",
              "default": {
                "max_fps": 30,
                "smoothing": 0.5
              },
              "description": "Options of `pose`."
            },
            "scenes": {
              "$ref": "#/$defs/SceneOptions",
              "default": {
                "min_shot_ms": 500,
                "threshold": 0.35
              },
              "description": "Options of `scenes`."
            },
            "silences": {
              "$ref": "#/$defs/SilenceOptions",
              "default": {
                "min_duration_ms": 300,
                "threshold_dbfs": -40.0
              },
              "description": "Options of `silences`."
            },
            "transcript": {
              "$ref": "#/$defs/TranscriptOptions",
              "default": {
                "keep_fillers": true,
                "min_pause_ms": 300
              },
              "description": "Options of `transcript`."
            }
          },
          "type": "object"
        },
        "PoseOptions": {
          "additionalProperties": false,
          "description": "Options of the `pose` analyzer.",
          "properties": {
            "max_fps": {
              "default": 30,
              "description": "Most frames analyzed per second, 1 to 60 (default 30); a faster source is analyzed\nat every other frame or sparser, and the body effects hold each result until the next.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "smoothing": {
              "default": 0.5,
              "description": "How much landmarks and masks are smoothed in time, from 0 (not at all) to 1 (a\nGaussian of two frames); fast moves are left alone. Default 0.5.",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "SceneOptions": {
          "additionalProperties": false,
          "description": "Options of the `scenes` analyzer.",
          "properties": {
            "min_shot_ms": {
              "default": 500,
              "description": "Shortest shot, in milliseconds: a cut sooner than this after the previous one (or\nthe start) is ignored (default 500).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "threshold": {
              "default": 0.35,
              "description": "Histogram change, from 0 to 1, that counts as a cut (default 0.35).",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "SilenceOptions": {
          "additionalProperties": false,
          "description": "Options of the `silences` analyzer.",
          "properties": {
            "min_duration_ms": {
              "default": 300,
              "description": "Shortest quiet run reported, in milliseconds (default 300).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "threshold_dbfs": {
              "default": -40.0,
              "description": "A window is quiet when its RMS level is below this, in dBFS (default -40).",
              "format": "double",
              "type": "number"
            }
          },
          "type": "object"
        },
        "TranscriptOptions": {
          "additionalProperties": false,
          "description": "Options of the `transcript` analyzer.",
          "properties": {
            "keep_fillers": {
              "default": true,
              "description": "Prompt the model to write fillers such as \"um\" instead of tidying them away\n(default true).",
              "type": "boolean"
            },
            "language": {
              "description": "Spoken language as a two-letter code such as `en`; detected when omitted, and always\nEnglish with English-only (`.en`) models.",
              "type": [
                "string",
                "null"
              ]
            },
            "min_pause_ms": {
              "default": 300,
              "description": "Gaps between words reported as pauses, in milliseconds (default 300).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "description": "Model name, for example `whisper-base.en`; the most capable installed speech model\nfor the language when omitted.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "analyzers": {
          "default": [],
          "description": "`loudness`, `silences`, `scenes` and/or `transcript`. When omitted, every analyzer the\nasset allows except `transcript`, which needs an installed speech model (see `models`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "asset": {
          "description": "The asset to analyze, for example `asset_0001` (from `media_list`).",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/Options",
          "default": {
            "beats": {
              "max_bpm": 220.0,
              "min_bpm": 50.0,
              "prior_bpm": 120.0,
              "tightness": 100.0
            },
            "levels": {
              "window_ms": 1000
            },
            "matte": {
              "every": 1,
              "max_fps": 30,
              "model": "person",
              "size": 512,
              "smoothing": 0.5
            },
            "pose": {
              "max_fps": 30,
              "smoothing": 0.5
            },
            "scenes": {
              "min_shot_ms": 500,
              "threshold": 0.35
            },
            "silences": {
              "min_duration_ms": 300,
              "threshold_dbfs": -40.0
            },
            "transcript": {
              "keep_fillers": true,
              "min_pause_ms": 300
            }
          },
          "description": "Analyzer options, for example `{\"silences\": {\"threshold_dbfs\": -35, \"min_duration_ms\":\n400}}` or `{\"transcript\": {\"language\": \"en\", \"min_pause_ms\": 250}}`; defaults when\nomitted."
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh": {
          "default": false,
          "description": "Measure again even if results are cached.",
          "type": "boolean"
        },
        "wait_seconds": {
          "description": "Seconds to wait for a measurement to finish before answering, 0 to 60 (default 30).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "asset"
      ],
      "type": "object"
    },
    "name": "media_analyze",
    "read_only": true
  },
  {
    "description": "Import video, audio or image files into the project's media table in one revision. Returns each new asset id (asset_...), which clip.add uses. Importing a file that is already in the project returns its existing asset. With relink set to an asset id, the one file given becomes that asset's new place, for media that was moved or renamed (media_list marks missing files).",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Report what would be added without changing the project.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "files": {
          "description": "Media files to import: video, audio or images. All are added in one revision.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "relink": {
          "default": null,
          "description": "Instead of adding it, the one file given is the new place of this moved asset.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key: repeating it with the same files returns the first result.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "files"
      ],
      "type": "object"
    },
    "name": "media_import",
    "read_only": false
  },
  {
    "description": "List the project's media: asset ids, names, kinds, durations, stream details, bin folders, the clips that use each asset, and missing: true for files that cannot be found (relink them with media_import).",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "media_list",
    "read_only": true
  },
  {
    "description": "List the models FossCut can install, with their task (speech for media_analyze transcript; matte, pose, voice and translate for local vision, voice and translation models; runtime for the ONNX Runtime library those run on), size, license, attribution, languages and whether each is installed, or install one. Installing downloads it and checks its SHA-256, and happens only after the user agrees: tell them the size and license first, then pass confirm: true. Larger speech models are more accurate and slower; English-only models (.en) suit English speech.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confirm": {
          "default": false,
          "description": "`true` only after the user agreed to the download size and license.",
          "type": "boolean"
        },
        "from": {
          "description": "Install from this local file instead of downloading; it is verified the same way.",
          "type": [
            "string",
            "null"
          ]
        },
        "install": {
          "description": "The model to install, for example `whisper-base.en`; omit to list the models.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "models",
    "read_only": false
  },
  {
    "description": "Project name, current revision, timelines with their formats, and whether undo or redo is possible.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "project_info",
    "read_only": true
  },
  {
    "description": "Create a new project bundle (a directory ending in .fosscut) with an empty timeline, and make it the open project. Defaults: 1920x1080 at 30 fps; use width 1080 and height 1920 for vertical video. Returns project info.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "height": {
          "description": "Timeline height in pixels (default 1080; 1920 for vertical video).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Project name; the directory name when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Bundle directory to create, for example `Promo.fosscut`. It must not exist or must\nbe empty.",
          "type": "string"
        },
        "rate": {
          "description": "Frame rate, for example `30`, `25` or `30000/1001` (default 30).",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "Timeline width in pixels (default 1920; 1080 for vertical video).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "project_new",
    "read_only": false
  },
  {
    "description": "Open an existing .fosscut project; later tools use it when they get no project argument. Returns project info: name, revision, timelines and undo state.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "description": "Path of an existing `.fosscut` bundle.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "project_open",
    "read_only": true
  },
  {
    "description": "Run any read-only query from capabilities by name with its arguments, for queries no other tool covers. preferences.read returns the user's preferences (editing and timeline defaults such as loudness_target, image_duration and frame_rate), so your requests can follow them; it needs no project, and only the user changes them.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "args": {
          "description": "Query arguments matching its schema."
        },
        "name": {
          "description": "Query name from `capabilities`, for example `history.list`.",
          "type": "string"
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "query",
    "read_only": true
  },
  {
    "description": "Record a voiceover, a camera or the screen of this machine into the project's recordings folder, or make a voiceover from text. Only when the user asked you to record: start needs confirm true. action speak says text with a local English voice (voice from action voices, speed; install kokoro-82m with models first) into the project's speech folder, imports it and places it at at (on track, or a free one; after the first audio track's last clip without at), as one undoable step; the same text and voice reuse the file. action devices lists the microphones, cameras and screens. action start (what: microphone, camera or screen; device and microphone by name, part of a name or number from devices; duration, size, fps) starts a background job and returns it: follow it with job_status, stop it with job_cancel (the recording is kept), and when it succeeded import recording.output with media_import, then place it with edit (clip.add). A microphone records 48 kHz stereo WAV; camera and screen the most compatible video this machine encodes.",
    "input": {
      "$defs": {
        "RecordAction": {
          "description": "What the `record` tool does.",
          "oneOf": [
            {
              "const": "devices",
              "description": "List the microphones, cameras and screens of this machine.",
              "type": "string"
            },
            {
              "const": "start",
              "description": "Start recording as a background job.",
              "type": "string"
            },
            {
              "const": "speak",
              "description": "Make a voiceover from text with a local English voice.",
              "type": "string"
            },
            {
              "const": "voices",
              "description": "List the local voices.",
              "type": "string"
            }
          ]
        },
        "TimeInput": {
          "description": "A time with an explicit unit. Frame and timecode values use the timeline frame rate. Bare numbers are rejected.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "frames": {
                  "type": "integer"
                }
              },
              "required": [
                "frames"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "seconds": {
                  "description": "Decimal seconds, for example \"3.9333\"",
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "seconds"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "timecode": {
                  "description": "HH:MM:SS:FF, or HH:MM:SS;FF for drop-frame",
                  "type": "string"
                }
              },
              "required": [
                "timecode"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "flicks": {
                  "type": "integer"
                }
              },
              "required": [
                "flicks"
              ],
              "type": "object"
            },
            {
              "description": "Shorthand: 118f, 3.9333s, 00:00:03:28 or 2775360000fl",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/RecordAction",
          "description": "`devices`, `start`, `speak` or `voices`."
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "speak: where to place the speech on the timeline; after the first audio track's last\nclip when omitted."
        },
        "confirm": {
          "default": false,
          "description": "start: `true` only when the user asked you to record. Recording uses their\nmicrophone, camera or screen.",
          "type": "boolean"
        },
        "device": {
          "description": "start: the device by name, a part of its name, or its number from 1 among its kind\nin `devices`; the first of its kind when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "start: stop after this long; until job_cancel when omitted."
        },
        "expected_revision": {
          "description": "speak: fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fps": {
          "description": "start: frame rate such as 30 or 60; 30 when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "description": "start: an FFmpeg input as FORMAT:INPUT instead of a device (for example\n`lavfi:sine=frequency=440`).",
          "type": [
            "string",
            "null"
          ]
        },
        "microphone": {
          "description": "start, for camera and screen: the microphone to record with it, chosen the same way,\nor `none`. A camera takes the first microphone and a screen none when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "start: picture size as [width, height]; 1920x1080 for a screen and 1280x720 for a\ncamera when omitted.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "speed": {
          "description": "speak: speaking speed from 0.5 to 2 (default 1).",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "text": {
          "description": "speak: the text to say.",
          "type": [
            "string",
            "null"
          ]
        },
        "track": {
          "description": "speak: the audio track to place it on; a free one when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "voice": {
          "description": "speak: the voice, such as `af_heart` (American) or `bm_george` (British); see\naction voices.",
          "type": [
            "string",
            "null"
          ]
        },
        "what": {
          "description": "start: `microphone` (a voiceover), `camera` or `screen`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "record",
    "read_only": false
  },
  {
    "description": "Redo the most recently undone change. Returns the new revision.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "redo",
    "read_only": false
  },
  {
    "description": "Read a timeline: its format, duration and revision, and every track with its clips (ids, start, duration, source range, text) in frames, timecode and seconds. Use the revision as expected_revision in edit.",
    "input": {
      "$defs": {
        "Detail": {
          "description": "How much `capabilities` and `timeline_read` include.",
          "oneOf": [
            {
              "const": "outline",
              "description": "Names and summaries only.",
              "type": "string"
            },
            {
              "const": "normal",
              "description": "Everything except schemas.",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Everything, including JSON Schemas.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ],
          "description": "`outline` counts clips per track, `normal` (default) lists every clip, `full` adds\nstyles and transforms."
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "description": "Timeline id; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "timeline_read",
    "read_only": true
  },
  {
