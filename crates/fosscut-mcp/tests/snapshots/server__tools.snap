---
source: crates/fosscut-mcp/tests/server.rs
expression: listing
---
[
  {
    "description": "Level the loudness of clips with sound: each clip is measured as it plays (its speed and sound effects applied) with the ITU-R BS.1770 meter on this machine, and its volume is set so it reaches target_lufs (default -14, the short-form platform level) with peaks under ceiling_dbfs (default -1). Where a clip's peaks leave too little room, an audio.limiter (gain and ceiling) makes up the rest unless limit is false. Silent clips keep their volume; clips with volume keyframes are refused. One undoable step with expected_revision, dry_run and request_id; returns each clip's measured loudness, peak, gain, new volume, limiter and the loudness it reaches.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "ceiling_dbfs": {
          "description": "Highest sample peak in dBFS, from -12 to 0; -1 when omitted.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "clips": {
          "description": "The clips with sound to level (audio, video or compound clips).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dry_run": {
          "default": false,
          "description": "Report what would change without committing it.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "description": "Add or adjust an `audio.limiter` where the peaks leave too little room for the\nvolume alone (the default); false only changes volumes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_lufs": {
          "description": "Target loudness in LUFS; -14 (short-form platforms) when omitted; podcasts use -16.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "clips"
      ],
      "type": "object"
    },
    "name": "audio_normalize",
    "read_only": false
  },
  {
    "description": "Edits measured from media on this machine, applied as one undoable step with expected_revision, dry_run and request_id. action split_scenes splits clip at its shot cuts (measured once and cached), so each shot is a clip of its own. action stabilize measures how the camera moved in clip and keys its transform.position, rotation and scale to cancel the shake (strength 0 to 1, default 0.5; up to 3 for a locked-off look), with one zoom up to 1.5 that hides the moving edges; it replaces those keyframes. action track follows region of clip (centre and size as fractions of the picture as it shows at at, found with frame_grab) from at to the clip's end, keying either mask (a mask of the clip: its centre follows) or follow (another clip such as a title or sticker: it moves as the region does from where it is); where the region is lost its last position holds and lost lists the ranges. action multicam makes a multicam clip of angles (video assets recorded at the same time, at least two): a compound timeline with each angle on its own track, lined up by offsets measured from their sound (unless offsets are given or sync is false; max_offset_seconds limits the search), one angle's sound (sound, from 1), placed at start; cut between angles afterwards with edit and the command multicam.switch. action multicam_sync only measures the offsets and their confidence (below 0.3 is doubtful). Returns the measurement and the response; check with frame_grab or contact_sheet.",
    "input": {
      "$defs": {
        "AutoEditAction": {
          "description": "What the `auto_edit` tool does.",
          "oneOf": [
            {
              "const": "split_scenes",
              "description": "Split a video clip at its scene changes.",
              "type": "string"
            },
            {
              "const": "stabilize",
              "description": "Steady a shaky video clip.",
              "type": "string"
            },
            {
              "const": "track",
              "description": "Make a mask or another clip follow a region of a video clip's picture.",
              "type": "string"
            },
            {
              "const": "multicam",
              "description": "Make a multicam clip from angles recorded at the same time, lined up by their sound.",
              "type": "string"
            },
            {
              "const": "multicam_sync",
              "description": "Only measure how far apart angles recorded at the same time started.",
              "type": "string"
            }
          ]
        },
        "RegionArg": {
          "description": "A region of a picture: its centre and size as fractions of the picture.",
          "properties": {
            "height": {
              "description": "The height, 0 to 1.",
              "format": "double",
              "type": "number"
            },
            "width": {
              "description": "The width, 0 to 1.",
              "format": "double",
              "type": "number"
            },
            "x": {
              "description": "The centre's distance from the left edge, 0 to 1.",
              "format": "double",
              "type": "number"
            },
            "y": {
              "description": "The centre's distance from the top edge, 0 to 1.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "type": "object"
        },
        "TimeInput": {
          "description": "A time with an explicit unit. Frame and timecode values use the timeline frame rate. Bare numbers are rejected.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "frames": {
                  "type": "integer"
                }
              },
              "required": [
                "frames"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "seconds": {
                  "description": "Decimal seconds, for example \"3.9333\"",
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "seconds"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "timecode": {
                  "description": "HH:MM:SS:FF, or HH:MM:SS;FF for drop-frame",
                  "type": "string"
                }
              },
              "required": [
                "timecode"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "flicks": {
                  "type": "integer"
                }
              },
              "required": [
                "flicks"
              ],
              "type": "object"
            },
            {
              "description": "Shorthand: 118f, 3.9333s, 00:00:03:28 or 2775360000fl",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/AutoEditAction",
          "description": "`split_scenes`, `stabilize`, `track`, `multicam` or `multicam_sync`."
        },
        "angles": {
          "default": [],
          "description": "multicam, multicam_sync: the angles' video asset ids, at least two, in order; the\nfirst shows at the start.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "track: the timeline time where `region` is given; the clip's start when omitted."
        },
        "clip": {
          "description": "split_scenes, stabilize, track: the video clip to measure.",
          "type": [
            "string",
            "null"
          ]
        },
        "dry_run": {
          "default": false,
          "description": "Report what would change without committing it.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "follow": {
          "description": "track: another clip, such as a title or sticker, that moves as the region does from\nwhere it is (motion tracking).",
          "type": [
            "string",
            "null"
          ]
        },
        "mask": {
          "description": "track: a mask of the clip whose centre follows the region (mask tracking).",
          "type": [
            "string",
            "null"
          ]
        },
        "max_offset_seconds": {
          "description": "multicam, multicam_sync: look at most this many seconds either way; any offset when\nomitted.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "description": "multicam: the multicam timeline's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "offsets": {
          "default": [],
          "description": "multicam: each angle's start in the scene, in order; measured from their sound when\nomitted, unless sync is false.",
          "items": {
            "$ref": "#/$defs/TimeInput"
          },
          "type": "array"
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionArg"
            },
            {
              "type": "null"
            }
          ],
          "description": "track: the region to follow at `at`, in the picture as it shows (find it with\nframe_grab)."
        },
        "request_id": {
          "description": "Retry key.",
          "type": [
            "string",
            "null"
          ]
        },
        "sound": {
          "description": "multicam: which angle's sound plays, by number from 1; the first when omitted.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "multicam: where the multicam clip starts; appended when omitted."
        },
        "strength": {
          "description": "stabilize: how much motion to remove, 0 (none) to 1 (very smooth), up to 3 for a\nlocked-off look; 0.5 when omitted.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "sync": {
          "description": "multicam: false lines the angles up at their starts instead of measuring offsets.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "timeline": {
          "description": "multicam: timeline for the multicam clip; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "track": {
          "description": "multicam: track for the multicam clip.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "auto_edit",
    "read_only": false
  },
  {
    "description": "List what FossCut can do: every editing command and query with a summary, the engine operations, the analyzers, the models and whether each is installed, and the export presets this machine can encode. Before using a command the first time, call it with names (for example [\"clip.add\", \"text.add\"]) to get just those argument schemas; detail: full returns every schema and error code at once and is large.",
    "input": {
      "$defs": {
        "Detail": {
          "description": "How much `capabilities` and `timeline_read` include.",
          "oneOf": [
            {
              "const": "outline",
              "description": "Names and summaries only.",
              "type": "string"
            },
            {
              "const": "normal",
              "description": "Everything except schemas.",
              "type": "string"
            },
            {
              "const": "full",
              "description": "Everything, including JSON Schemas.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "detail": {
          "$ref": "#/$defs/Detail",
          "description": "`outline` (default) lists names and summaries; `full` adds every command's JSON\nSchema, the request and time schemas, and the error codes (large)."
        },
        "names": {
          "default": [],
          "description": "Only these commands and queries, each with its argument JSON Schema, for example\n`[\"clip.add\", \"text.add\"]`. Ask for the commands you are about to use.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "name": "capabilities",
    "read_only": true
  },
  {
    "description": "Word-timed captions. action generate captions the clips of a track from their cached transcripts (run media_analyze with analyzers [\"transcript\"] first): words become pages of a few words on a caption track, styled by preset (bold-pop, highlight, karaoke or boxed) and style. action import adds pages from an SRT file, one per cue; action export writes a caption track to an SRT file. generate and import are one undoable step with expected_revision, dry_run and request_id. Then change pages with edit (captions.edit) and the look with captions.style, and check frame_grab at a spoken word.",
    "input": {
      "$defs": {
        "CaptionsAction": {
          "description": "What the `captions` tool does.",
          "oneOf": [
            {
              "const": "generate",
              "description": "Caption the clips of a track from their cached transcripts.",
              "type": "string"
            },
            {
              "const": "import",
              "description": "Add caption pages from an SRT file, one page per cue.",
              "type": "string"
            },
            {
              "const": "export",
              "description": "Write a caption track to an SRT file.",
              "type": "string"
            }
          ]
        },
        "TranscriptOptions": {
          "additionalProperties": false,
          "description": "Options of the `transcript` analyzer.",
          "properties": {
            "keep_fillers": {
              "default": true,
              "description": "Prompt the model to write fillers such as \"um\" instead of tidying them away\n(default true).",
              "type": "boolean"
            },
            "language": {
              "description": "Spoken language as a two-letter code such as `en`; detected when omitted, and always\nEnglish with English-only (`.en`) models.",
              "type": [
                "string",
                "null"
              ]
            },
            "min_pause_ms": {
              "default": 300,
              "description": "Gaps between words reported as pauses, in milliseconds (default 300).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "description": "Model name, for example `whisper-base.en`; the most capable installed speech model\nfor the language when omitted.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/CaptionsAction",
          "description": "`generate` (from transcripts), `import` (an SRT file) or `export` (to an SRT file)."
        },
        "allow_destructive": {
          "default": false,
          "description": "Allow replacing captions or overwriting an existing file. Ask the user first.",
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "description": "Report what would change without committing it (or, for export, without writing).",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "description": "The SRT file to import or to write.",
          "type": [
            "string",
            "null"
          ]
        },
        "lyrics": {
          "default": false,
          "description": "generate: caption a song's lyrics: the music track first, one sung line per page,\nthe karaoke look unless a preset is given.",
          "type": "boolean"
        },
        "paging": {
          "description": "generate: paging limits, for example `{\"max_words\": 3, \"max_lines\": 1}`."
        },
        "preset": {
          "description": "A built-in look: `bold-pop`, `highlight`, `karaoke` or `boxed` (capabilities lists\nthem with descriptions).",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "replace": {
          "default": false,
          "description": "Replace the caption track's existing captions; also needs allow_destructive.",
          "type": "boolean"
        },
        "request_id": {
          "description": "Retry key for generate and import.",
          "type": [
            "string",
            "null"
          ]
        },
        "skip_fillers": {
          "default": false,
          "description": "generate: leave out the words the transcript marks as fillers (\"um\", \"uh\").",
          "type": "boolean"
        },
        "source_track": {
          "description": "generate: the track whose clips are captioned; the first video or audio track with\nsound when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "description": "Changes to the caption track's look as a JSON merge patch, for example\n`{\"placement\": \"middle\", \"size\": 0.07}`."
        },
        "subtitles": {
          "description": "export: `original` (the default), `translation` (each page's translation line) or\n`both` (bilingual: the words, then the translation).",
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "description": "Timeline; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "track": {
          "description": "Caption track; the first caption track (created when adding) when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "#/$defs/TranscriptOptions",
          "default": {
            "keep_fillers": true,
            "min_pause_ms": 300
          },
          "description": "generate: the transcript options the media was analyzed with (`model`, `language`,\n`min_pause_ms`), if not the defaults."
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "captions",
    "read_only": false
  },
  {
    "description": "Automatic color for a video or image clip, measured from its frames on this machine. action auto adds a color.adjust effect (first in the clip's effects) that neutralizes the white balance, sets the brightness and stretches blacks and whites; action match adds one that brings the clip's balance, brightness, contrast and saturation close to the reference clip. One undoable step with expected_revision, dry_run and request_id; returns the measurements and the effect. Adjust the effect afterwards with edit (effect.set) and check frame_grab.",
    "input": {
      "$defs": {
        "ColorAction": {
          "description": "What the `color` tool does.",
          "oneOf": [
            {
              "const": "auto",
              "description": "Correct white balance, brightness and levels.",
              "type": "string"
            },
            {
              "const": "match",
              "description": "Bring the clip close to a reference clip.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/ColorAction",
          "description": "`auto` or `match`."
        },
        "clip": {
          "description": "The video or image clip to correct.",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "description": "Report what would change without committing it.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "description": "match: the clip whose look to match.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "description": "Retry key.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "clip"
      ],
      "type": "object"
    },
    "name": "color",
    "read_only": false
  },
  {
    "description": "Render frames spread evenly over the timeline into one PNG grid (default 12 frames, 240 pixels wide each), to check a whole edit at a glance. Returns the image and each tile's time and position.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "Frames to show, 1 to 100 (default 12), from the middle of equal parts of the\ntimeline.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "description": "Timeline id; the primary timeline when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "Width of each frame in pixels (default 240).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "contact_sheet",
    "read_only": true
  },
  {
    "description": "Change the project: apply one or more commands (clip.add, clip.split, clip.move, clip.remove, text.add, track.add and others from capabilities) in order as one atomic transaction and one undo step. Pass expected_revision from your last read; dry_run: true reports the changes without committing; a request_id makes retries safe. Returns the new revision, each command's result and a summary of changes.",
    "input": {
      "$defs": {
        "CommandCall": {
          "additionalProperties": false,
          "description": "One command invocation inside a request.",
          "properties": {
            "args": {
              "default": null,
              "description": "Arguments matching the command's input schema."
            },
            "command": {
              "description": "Command name, for example `clip.split`.",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allow_destructive": {
          "default": false,
          "description": "Allow destructive changes such as removing clips from the main video track. Ask the\nuser first.",
          "type": "boolean"
        },
        "commands": {
          "description": "Commands applied in order as one transaction and one undo step, for example\n`[{\"command\": \"clip.split\", \"args\": {\"clip\": \"clip_0003\", \"at\": {\"timecode\": \"00:00:03:28\"}}}]`.\n`capabilities` with `detail: full` gives each command's argument schema.",
          "items": {
            "$ref": "#/$defs/CommandCall"
          },
          "type": "array"
        },
        "dry_run": {
          "default": false,
          "description": "Validate and report the changes without committing them.",
          "type": "boolean"
        },
        "expected_revision": {
          "description": "Fail with `fosscut.revision.conflict` unless the project is at this revision; pass\nthe revision from your last read.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Path of a `.fosscut` bundle; the open project when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why, recorded in the project's history.",
          "type": [
            "string",
            "null"
          ]
        },
